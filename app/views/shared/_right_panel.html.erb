<aside class="bg-surface dark:bg-dark-surface border-l border-border dark:border-dark-border overflow-y-auto p-4 sm:p-5 space-y-5 lg:h-full">
  <!-- Weather Widget -->
  <div class="bg-surface dark:bg-dark-surface rounded-xl border border-border dark:border-dark-border shadow-card p-4 sm:p-5">
    <div class="flex justify-between items-center mb-3 sm:mb-4"><h4 class="text-xs sm:text-sm font-bold text-text-muted dark:text-dark-text-sec uppercase tracking-wider">Clima en tiempo real</h4><a class="text-xs text-primary font-bold hover:underline" href="#">Ver más</a></div>
    <div class="flex items-center gap-3"><img class="w-12 h-12 sm:w-14 sm:h-14 rounded-lg object-cover" src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=100&q=80" alt="Bali"/><div class="min-w-0 flex-1"><p class="text-sm sm:text-base font-bold text-text-primary dark:text-dark-text truncate">Bali, Indonesia</p><p class="text-xs text-text-muted dark:text-dark-text-sec">18 Mayo, 2024</p></div></div>
    <div class="mt-3 sm:mt-4 flex items-center gap-3"><span class="text-2xl sm:text-3xl">☀️</span><span class="text-xl sm:text-2xl font-bold text-text-primary dark:text-dark-text">29°</span><span class="text-sm text-text-secondary dark:text-dark-text-sec">Soleado</span></div>
    <div class="mt-3 sm:mt-4 grid grid-cols-3 gap-2 sm:gap-3 border-t border-border dark:border-dark-border pt-3 text-center">
      <div><p class="text-[11px] text-text-muted dark:text-dark-text-sec">💧 Humedad</p><p class="text-xs sm:text-sm font-bold text-text-primary dark:text-dark-text">65%</p></div>
      <div><p class="text-[11px] text-text-muted dark:text-dark-text-sec">💨 Viento</p><p class="text-xs sm:text-sm font-bold text-text-primary dark:text-dark-text">12 km/h</p></div>
      <div><p class="text-[11px] text-text-muted dark:text-dark-text-sec">🌡️ Sensación</p><p class="text-xs sm:text-sm font-bold text-text-primary dark:text-dark-text">32°C</p></div>
    </div>
  </div>

  <!-- Price Alerts Widget -->
  <div class="bg-surface dark:bg-dark-surface rounded-xl border border-border dark:border-dark-border shadow-card p-4 sm:p-5">
    <div class="flex justify-between items-center mb-3 sm:mb-4"><h4 class="text-xs sm:text-sm font-bold text-text-muted dark:text-dark-text-sec uppercase tracking-wider">Alerta de precios</h4><a class="text-xs text-primary font-bold hover:underline" href="#">Ver todas</a></div>
    <div class="flex justify-between items-start"><div><p class="text-sm sm:text-base font-bold text-text-primary dark:text-dark-text">Bogotá ✈️ Madrid</p><p class="text-lg sm:text-xl font-bold text-primary mt-1">$2.340.000 <span class="text-xs text-text-muted dark:text-dark-text-sec font-normal">COP</span></p><p class="text-xs text-green-600 font-medium mt-1">Bajó 18% desde ayer</p></div><span class="bg-green-100 dark:bg-green-900/30 text-green-700 text-xs font-bold px-2 py-1 rounded-md">-18%</span></div>
    <div class="mt-3 sm:mt-4 h-12 sm:h-14 flex items-end gap-1"><% [8,12,10,6,14,4,5].each do |h| %><div class="bg-primary/30 flex-1 rounded-t-sm" style="height:<%= h*4 %>px"></div><% end %></div>
    <div class="flex justify-between mt-1 text-[10px] text-text-muted dark:text-dark-text-sec"><span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span></div>
    <button class="w-full mt-3 sm:mt-4 py-2 bg-primary-light dark:bg-primary/20 border border-primary/20 rounded-lg text-xs sm:text-sm font-bold text-primary hover:bg-primary hover:text-white transition-all">Ver ofertas</button>
  </div>

  <!-- Saved Items Widget -->
  <div class="bg-surface dark:bg-dark-surface rounded-xl border border-border dark:border-dark-border shadow-card p-4 sm:p-5">
    <div class="flex justify-between items-center mb-3 sm:mb-4"><h4 class="text-xs sm:text-sm font-bold text-text-muted dark:text-dark-text-sec uppercase tracking-wider">Guardados</h4><a class="text-xs text-primary font-bold hover:underline" href="#">Ver todos</a></div>
    <% [['París, Francia','$3.250.000','https://images.unsplash.com/photo-1502602898657-3e91760cbb34?w=100&q=80'],['Bali, Indonesia','$4.120.000','https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=100&q=80'],['Tokio, Japón','$5.890.000','https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?w=100&q=80']].each do |name, price, img| %>
      <div class="flex items-center gap-3 py-2 border-b border-border/50 dark:border-dark-border/50 last:border-0"><img class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg object-cover" src="<%= img %>" alt="<%= name %>"/><div class="flex-1 min-w-0"><p class="text-xs sm:text-sm font-bold text-text-primary dark:text-dark-text truncate"><%= name %></p><p class="text-[11px] text-text-muted dark:text-dark-text-sec">Desde <%= price %></p></div><span class="text-base text-red-500">❤️</span></div>
    <% end %>
  </div>

  <!-- AI Recommendation Widget -->
  <div class="bg-primary-light dark:bg-primary/10 rounded-xl border border-primary/30 p-4 sm:p-5">
    <div class="flex items-center gap-3 mb-3"><span class="text-2xl">🤖</span><div class="min-w-0"><p class="text-xs text-primary font-semibold flex items-center gap-1">Recomendación IA <span class="bg-primary text-white text-[9px] font-bold px-1.5 py-0.5 rounded">BETA</span></p><p class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text mt-0.5 truncate">Tailandia 🇹🇭</p><p class="text-xs text-text-secondary dark:text-dark-text-sec">7 días desde $1.890.000 COP</p></div></div>
    <button class="w-full py-2 bg-surface dark:bg-dark-surface border border-primary/30 rounded-lg text-xs sm:text-sm font-bold text-primary hover:bg-primary hover:text-white transition-all">Ver itinerario sugerido</button>
  </div>
</aside>

