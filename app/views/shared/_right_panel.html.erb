<aside class="bg-surface dark:bg-dark-surface border-l border-border dark:border-dark-border overflow-y-auto p-5 space-y-5" style="grid-column: 3; grid-row: 2;">
  <div class="bg-surface dark:bg-dark-surface rounded-lg border border-border dark:border-dark-border shadow-card p-5">
    <div class="flex justify-between items-center mb-4"><h4 class="text-sm font-bold text-text-muted dark:text-dark-text-sec uppercase tracking-wider">Clima</h4><a class="text-xs text-primary font-bold" href="#">Ver más</a></div>
    <div class="flex items-center gap-3"><img class="w-14 h-14 rounded-md object-cover" src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=100&q=80"/><div><p class="text-base font-bold text-text-primary dark:text-dark-text">Bali, Indonesia</p><p class="text-sm text-text-muted dark:text-dark-text-sec">18 Mayo, 2024</p></div></div>
    <div class="mt-4 flex items-center gap-3"><span class="text-3xl">☀️</span><span class="text-2xl font-bold text-text-primary dark:text-dark-text">29°</span><span class="text-base text-text-secondary dark:text-dark-text-sec">Soleado</span></div>
    <div class="mt-4 grid grid-cols-3 gap-3 border-t border-border dark:border-dark-border pt-4 text-center">
      <div><p class="text-xs text-text-muted dark:text-dark-text-sec">💧 Humedad</p><p class="text-sm font-bold text-text-primary dark:text-dark-text">65%</p></div>
      <div><p class="text-xs text-text-muted dark:text-dark-text-sec">💨 Viento</p><p class="text-sm font-bold text-text-primary dark:text-dark-text">12 km/h</p></div>
      <div><p class="text-xs text-text-muted dark:text-dark-text-sec">🌡️ Sensación</p><p class="text-sm font-bold text-text-primary dark:text-dark-text">32°C</p></div>
    </div>
  </div>
  <div class="bg-surface dark:bg-dark-surface rounded-lg border border-border dark:border-dark-border shadow-card p-5">
    <div class="flex justify-between items-center mb-4"><h4 class="text-sm font-bold text-text-muted dark:text-dark-text-sec uppercase tracking-wider">Alerta precios</h4><a class="text-xs text-primary font-bold" href="#">Ver todas</a></div>
    <div class="flex justify-between items-start"><div><p class="text-base font-bold text-text-primary dark:text-dark-text">Bogotá ✈️ Madrid</p><p class="text-xl font-bold text-primary mt-1">$2.340.000 <span class="text-sm text-text-muted dark:text-dark-text-sec font-normal">COP</span></p><p class="text-xs text-green-600 font-medium mt-1">Bajó 18% desde ayer</p></div><span class="bg-green-100 dark:bg-green-900/30 text-green-700 text-sm font-bold px-2.5 py-1 rounded">-18%</span></div>
    <div class="mt-4 h-14 flex items-end gap-0.5"><% [8,12,10,6,14,4,5].each do |h| %><div class="bg-primary/30 flex-1 rounded-t-sm" style="height:<%= h*4 %>px"></div><% end %></div>
    <div class="flex justify-between mt-1 text-[10px] text-text-muted dark:text-dark-text-sec"><span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span></div>
    <button class="w-full mt-4 py-2.5 bg-primary-light dark:bg-primary/20 border border-primary/20 rounded-xs text-sm font-bold text-primary hover:bg-primary hover:text-white transition-all">Ver ofertas</button>
  </div>
  <div class="bg-surface dark:bg-dark-surface rounded-lg border border-border dark:border-dark-border shadow-card p-5">
    <div class="flex justify-between items-center mb-4"><h4 class="text-sm font-bold text-text-muted dark:text-dark-text-sec uppercase tracking-wider">Guardados</h4><a class="text-xs text-primary font-bold" href="#">Ver todos</a></div>
    <% [['París, Francia','$3.250.000','https://images.unsplash.com/photo-1502602898657-3e91760cbb34?w=100&q=80'],['Bali, Indonesia','$4.120.000','https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=100&q=80'],['Tokio, Japón','$5.890.000','https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?w=100&q=80']].each do |name, price, img| %>
      <div class="flex items-center gap-3 py-2.5 border-b border-border/50 dark:border-dark-border/50 last:border-0"><img class="w-10 h-10 rounded-md object-cover" src="<%= img %>"/><div class="flex-1"><p class="text-sm font-bold text-text-primary dark:text-dark-text"><%= name %></p><p class="text-xs text-text-muted dark:text-dark-text-sec">Desde <%= price %></p></div><span class="text-lg text-red-500">❤️</span></div>
    <% end %>
  </div>
  <div class="bg-primary-light dark:bg-primary/10 rounded-lg border border-primary/30 p-5">
    <div class="flex items-center gap-3 mb-3"><span class="text-2xl">🤖</span><div><p class="text-sm text-primary font-medium">Recomendación IA <span class="bg-primary text-white text-[10px] font-bold px-2 py-0.5 rounded ml-1">BETA</span></p><p class="text-lg font-bold text-text-primary dark:text-dark-text mt-1">Tailandia 🇹🇭</p><p class="text-sm text-text-secondary dark:text-dark-text-sec">7 días desde $1.890.000 COP</p></div></div>
    <button class="w-full py-2.5 bg-surface dark:bg-dark-surface border border-primary/30 rounded-xs text-sm font-bold text-primary hover:bg-primary hover:text-white transition-all">Ver itinerario sugerido</button>
  </div>
</aside>
