<header class="sticky top-0 z-30 bg-white/95 dark:bg-dark-surface/95 backdrop-blur-md border-b border-border dark:border-dark-border flex items-center justify-between px-4 sm:px-6 h-[60px] lg:col-span-full">
  <div class="flex items-center gap-3 sm:gap-4 flex-1">
    <!-- Mobile Hamburger Toggle -->
    <button onclick="toggleMobileSidebar()" type="button" class="lg:hidden p-2 rounded-lg text-text-secondary dark:text-dark-text-sec hover:bg-gray-100 dark:hover:bg-dark-border transition-colors" title="Abrir menú">
      <span class="text-xl">☰</span>
    </button>

    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2">
      <div class="w-8 h-8 bg-gradient-to-tr from-primary to-secondary text-white rounded-full flex items-center justify-center shadow-card shrink-0">
        <span class="text-base">🌴</span>
      </div>
      <div>
        <h1 class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text leading-none">Travel<span class="text-primary">IA</span></h1>
        <p class="hidden sm:block text-[11px] text-text-muted dark:text-dark-text-sec">Descubre. Planifica. Vive.</p>
      </div>
    </a>

    <!-- Desktop Search -->
    <div class="relative hidden sm:block ml-4 md:ml-6 flex-1 max-w-md">
      <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-text-muted dark:text-dark-text-sec text-sm">🔍</span>
      <input class="w-full pl-9 pr-3 py-2 bg-gray-100 dark:bg-dark-bg border border-transparent dark:border-dark-border rounded-lg text-sm focus:border-primary focus:bg-white dark:focus:bg-dark-surface outline-none transition-all placeholder:text-text-muted dark:placeholder:text-dark-text-sec text-text-primary dark:text-dark-text" placeholder="Buscar destinos, experiencias, guías..." type="text"/>
    </div>
  </div>

  <!-- Actions & Profile -->
  <div class="flex items-center gap-2 sm:gap-3">
    <!-- Mobile Search Trigger Icon -->
    <button onclick="toggleMobileSearch()" class="sm:hidden p-2 rounded-lg text-xl hover:bg-gray-100 dark:hover:bg-dark-border transition-colors" title="Buscar">
      🔍
    </button>

    <!-- Dark mode toggle -->
    <button onclick="toggleDark()" class="text-lg sm:text-xl cursor-pointer hover:scale-110 transition-transform p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-dark-border text-text-primary dark:text-dark-text" title="Cambiar modo">
      <span class="dark:hidden">🌙</span><span class="hidden dark:inline">☀️</span>
    </button>

    <!-- Notifications -->
    <button type="button" class="text-lg sm:text-xl cursor-pointer relative p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-dark-border text-text-primary dark:text-dark-text">
      🔔<span class="absolute top-1.5 right-1.5 bg-red-500 text-white text-[9px] w-4 h-4 flex items-center justify-center rounded-full font-bold">3</span>
    </button>

    <!-- Profile Badge -->
    <a href="/perfil" class="flex items-center gap-2 border-l border-border dark:border-dark-border pl-3 sm:pl-4 cursor-pointer hover:opacity-80 transition-opacity">
      <div class="text-right hidden md:block">
        <p class="text-sm font-semibold text-text-primary dark:text-dark-text leading-tight">Laura M.</p>
        <p class="text-[11px] text-text-muted dark:text-dark-text-sec">Exploradora</p>
      </div>
      <img class="w-8 h-8 sm:w-9 sm:h-9 rounded-full border-2 border-primary-light dark:border-primary/30 shadow-card object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAdVekUkC-22ClIgOMESzmQntk28dTJP1nGhvdwuuvcT8n6rX_0A87YwgTP-evTmT5SaHSvxyG_TOrBdOQZzBdJ7MK6YU4FkG87F6-Bp-V2NkXvbR_oVpOrEJRww7ABrYyy3s6dSDLDaOhTC4N3rieNWW05Gl8cZcXWhc5InBT8fBfNcr8fxenl1s87PqFJ9D0HMZJw7r60tb76vxjJhaDRhndrbJUEL5ykBUraFrQWYk8qPciCK7DEKATGiMRucuIueVr_s4QC2fby" alt="Avatar"/>
    </a>
  </div>
</header>

<!-- Mobile Search Bar overlay (collapsible) -->
<div id="mobile-search-bar" class="hidden sm:hidden bg-white dark:bg-dark-surface border-b border-border dark:border-dark-border px-4 py-2.5 transition-all">
  <div class="relative">
    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-text-muted dark:text-dark-text-sec text-sm">🔍</span>
    <input class="w-full pl-9 pr-3 py-2 bg-gray-100 dark:bg-dark-bg border border-transparent dark:border-dark-border rounded-lg text-sm outline-none text-text-primary dark:text-dark-text" placeholder="Buscar destinos, experiencias..." type="text"/>
  </div>
</div>

