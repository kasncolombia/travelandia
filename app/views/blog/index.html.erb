<%= render partial: "shared/head" %>

<div class="min-h-screen bg-background dark:bg-dark-bg flex flex-col lg:grid lg:grid-rows-[60px_1fr] lg:grid-cols-[260px_1fr_300px] xl:grid-cols-[280px_1fr_320px] lg:h-screen lg:overflow-hidden pb-16 lg:pb-0">

  <%= render partial: "shared/topbar" %>
  <%= render partial: "shared/sidebar" %>

  <!-- MAIN CONTENT - BLOG INDEX -->
  <main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6 bg-background dark:bg-dark-bg lg:col-start-2 lg:row-start-2">

    <!-- Featured Blog Hero -->
    <section class="relative w-full min-h-[340px] sm:h-[420px] lg:h-[460px] flex items-end overflow-hidden rounded-2xl shadow-card">
      <div class="absolute inset-0 z-0">
        <img class="w-full h-full object-cover" alt="Playa turquesa en Maldivas al atardecer" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAzb-QOEEt0Gpfv4rywSWthrXE735KDpXqllV2rj_hUhTzKZcyn7hgGeDPcy0WxbpsaWlQZvjwX2qrd0HRNJePX-20GTaKUAJeEJ_KJUMy8imFxVfoknV8fTrWeD3VZckkaFEhxgupeIsOZphZ3hmt4UB2kQhLB2zsZNSa1ki3iSuoRxeRRGOdxXfNAgdUZol26JqWTwnUzexja5yljvpJuEAz5PpRG_1rOYQ-OAcA4TCTJd6F2H8d4U3HcxSV-0T1eFMOtj1tmX5kV"/>
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
      </div>
      <div class="relative z-10 max-w-3xl bg-surface/80 dark:bg-dark-surface/80 backdrop-blur-xl p-4 sm:p-6 rounded-xl border border-border dark:border-dark-border m-3 sm:m-6 shadow-card">
        <span class="inline-block bg-primary/10 text-primary px-3 py-0.5 rounded-full text-xs font-bold mb-2">Historia Destacada</span>
        <h1 class="text-lg sm:text-2xl font-bold text-text-primary dark:text-dark-text mb-2 leading-tight">El Futuro de los Viajes: Cómo la IA Personaliza tu Próxima Aventura</h1>
        <p class="text-xs sm:text-sm text-text-secondary dark:text-dark-text-sec mb-3 line-clamp-2 sm:line-clamp-none">Descubre cómo la inteligencia generativa está yendo más allá de las reservas simples para crear experiencias adaptadas a tu estilo único.</p>
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full overflow-hidden border-2 border-primary shrink-0">
            <img class="w-full h-full object-cover" alt="Elena Rodriguez" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA_zEpwQInKbXRYQUS7Gs-esvy-ut--jhMI3YrhH9Laavsq1RZbXFu5phDL45iQV6kwbhUd8nrkqCtRJbZFpJMkVFBj-l2A4Ekj0XrEKMoXH0ZwMLVsPnBiOrXZG8z8wC62ipl6_-kpEZpEaYflVSW6X-RXTAtUJv5ff7y69RJlz4Q0TcMYeDr3t9On98J8EERfdqDS_by-_rBDNldBeUUg75DAQU6GiL-aV1fd-XpEm4QFPr0nHGIFLThkoO6xxMRMOLV_YtC3MW-i"/>
          </div>
          <div class="flex flex-col min-w-0">
            <span class="text-xs sm:text-sm font-bold text-text-primary dark:text-dark-text truncate">Elena Rodriguez</span>
            <span class="text-[11px] text-text-secondary dark:text-dark-text-sec">Estratega Jefe &bull; 8 min lectura</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Filters & Search Bar -->
    <section class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
      <div class="flex flex-wrap gap-1.5 sm:gap-2">
        <button class="bg-primary text-white px-3.5 py-1.5 rounded-full text-xs font-bold">Todos</button>
        <button class="bg-surface dark:bg-dark-surface text-text-secondary dark:text-dark-text-sec px-3.5 py-1.5 rounded-full text-xs font-semibold hover:bg-gray-100 dark:hover:bg-dark-border transition-colors">Destinos</button>
        <button class="bg-surface dark:bg-dark-surface text-text-secondary dark:text-dark-text-sec px-3.5 py-1.5 rounded-full text-xs font-semibold hover:bg-gray-100 dark:hover:bg-dark-border transition-colors">Tips</button>
        <button class="bg-surface dark:bg-dark-surface text-text-secondary dark:text-dark-text-sec px-3.5 py-1.5 rounded-full text-xs font-semibold hover:bg-gray-100 dark:hover:bg-dark-border transition-colors">IA</button>
        <button class="bg-surface dark:bg-dark-surface text-text-secondary dark:text-dark-text-sec px-3.5 py-1.5 rounded-full text-xs font-semibold hover:bg-gray-100 dark:hover:bg-dark-border transition-colors">Comunidad</button>
      </div>

      <div class="relative w-full sm:w-64">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-text-muted dark:text-dark-text-sec text-base">search</span>
        <input class="w-full pl-9 pr-4 py-2 bg-surface dark:bg-dark-surface border border-border dark:border-dark-border rounded-full text-xs sm:text-sm focus:ring-2 focus:ring-primary text-text-primary dark:text-dark-text placeholder:text-text-muted" placeholder="Buscar historias..." type="text"/>
      </div>
    </section>

    <!-- Articles Grid -->
    <section>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        <% articles = [
          { slug: 'tesoros-ocultos-barcelona', title: 'Los Tesoros Ocultos de Barcelona: Más Allá de Gaudí', tag: 'Destinos', date: '24 Oct, 2024', read: '5 min', excerpt: 'Aléjate de las rutas turísticas y explora los jardines secretos, clubes de jazz subterráneos y mercados locales que definen el verdadero espíritu de Cataluña.', img: 'https://lh3.googleusercontent.com/aida-public/AB6AXuBa0clPIMZ60hhAnvdXYdOfRWyW3LO-iyWpvFRBBo0epvtEB90I3yarDUnV9HxtmlJtFp2hnzyMSwIT_u8ruhJ3fOP-r1yh_E8qYmt3g7tcmaokSDwXSzBL7eU6u3hvrL_nZhD0XJ5rMQDvCg_bhm5AsxS4hhA63xjhBVrnMEKSySZyvHoyXDCqXx5Nl4vHAnY3ajhDBYSJYWwQ_YJEUh0D1NrZhcaNqNpq84ju_fM21AQ1fqWe1v_2nItegbKUzY5zqrei_F-JpHQG' },
          { slug: 'conserje-neural-tecnologia', title: 'Conserje Neural: La Tecnología Detrás de TravelIA', tag: 'IA', date: '22 Oct, 2024', read: '12 min', excerpt: 'Una mirada interna a cómo nuestros algoritmos propietarios analizan millones de datos para predecir tu itinerario perfecto antes de que lo sueñes.', img: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDmqg3mvKLiMwKga24NPS4exwz6QCkTS67C996c-TNhY40GvOHGfip1Nif2h-b1XiM1BXmCzEUF0c-NtdFl8o_dyJoOciLbeBvWgOAzcYBlWjfVgZLl3aOO86f42UG_Kogffv3w10Pl-NSQr3MDmNCJBSZ1mV4uSQ5s_vtUlcHf-L7LxCXxtTHIOGB9SvsrjnXiakzJCqaPT9mqumPguacsyNAMHn7yBomQ5Q24Mx68J1Sd_StPk04ScdT4kIfIKoVZLGn9U7UEla2B' },
          { slug: 'viajero-solitario-alpes', title: 'Viajero Destacado: Solitario en los Alpes Suizos', tag: 'Comunidad', date: '18 Oct, 2024', read: '6 min', excerpt: 'Conoce a Sarah, una miembro de TravelIA que usó nuestra IA para planificar una expedición de un mes en solitario por los Alpes suizos.', img: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDVnAZx8IU6hc0e4NkqaoWpHmg_S9viCVY-Q8twUcsz5dJ_x4-Ruq-lCu0eJwfpy9MHngx4XAf63Sq2WOiNZ9qzAgG1e5g_h6RGKk00hGnVgK31IGUBAXNuNsNS6j3w6a4FGtMe4f3dIdriYexF8mYG4xDNsCSiuAy6kVA2LhYSzl1gXXy_4a9rjVJFHY28F51y45a67argLDMr9pBJT52cwJLZtetINHfLeEvfYXjVrD4ACh0rD11yYMqkBefchVGCniH4f8Z-oE65' },
          { slug: 'empacar-ligero-regla-5-4-3-2-1', title: 'Empacar Ligero: La Regla 5-4-3-2-1', tag: 'Tips', date: '15 Oct, 2024', read: '4 min', excerpt: 'Domina el arte del equipaje de mano con nuestra guía definitiva para empacar de forma minimalista en un viaje de 10 días sin sacrificar estilo.', img: 'https://lh3.googleusercontent.com/aida-public/AB6AXuC_YhacPQ7z7AyLFyOjB4w2ZZAom5JuQ7P3PHEyslf1W5QKytvcMTqHR0iubgjTgG8Pc91zLbljfVU6kvsTs4VvslTgzTd52ENHvnZMrW4ePBoAwOnxDnS5GWG7Ki84GdBQyWhIuU0BpBYnJyPwxbS1pN7bpmTsR07BlCUqP-ocyEzXfdA9ZPArchXCEKyOHF3TLwW7XPLH_3Ml_y1FdzyUeZ9f0ngVda_sziD5OYaSnrgXwVhne5sdP2deW_fPLMY6BVzWCPXuHwsM' },
          { slug: 'dolomitas-itinerario-7-dias', title: 'Dolomitas: El Itinerario Perfecto de 7 Días', tag: 'Destinos', date: '10 Oct, 2024', read: '7 min', excerpt: 'Desde los icónicos picos de Tre Cime hasta los valles escondidos de Val Gardena, desglosamos la guía definitiva de senderismo por el norte de Italia.', img: 'https://lh3.googleusercontent.com/aida-public/AB6AXuC5LbEt3YKqbna3wKGrP__Sx7xGtkJZYl0t7S3tjE7X42j9fjpjPBfVgUilpMETm5YvuS3BAbnTUAmdiZTEHwd3w6ZkkBE2UzXRAH3ePDLqtEDiEMveJVPUXaNT8xZ-0Mx3Uy7LZUHmRhZzkVejApOyt7H7XucMLBndxMxq2UqYoT9gKcY4LBlZOGKxcqU7caFg2VhmMsOeftsBQnhKEqlXmyaUHZZFtPQgKJUa86-bu51sJcXmsjjJ1YkkGU4KCsaSZ_IvH2zg4x19' },
          { slug: 'asistente-invisible-ia', title: 'El Asistente Invisible: Viviendo con IA', tag: 'IA', date: '05 Oct, 2024', read: '9 min', excerpt: 'Cómo la inteligencia ambiental está cambiando la forma en que navegamos nuevas ciudades, desde traducciones en tiempo real hasta reprogramaciones.', img: 'https://lh3.googleusercontent.com/aida-public/AB6AXuDDk-PWZ87zxO8S07A471hnMXhR1xSihVfHq6xG9xjpSnlY8eEHKq3FPco9BUwFjczOiMbRT15OJc6Of6g1l692t3KS01kTpG8QBk07JHykLAtFPuAmJj0dKpyCEW-QXPO9X1wOHB-yyoVEXh2qAWYKbHcXeuQcVwutorwR4nGn9xFvrIBKXWS5XdDycF9m15EgMCcrQ4WYTSEUJ7HoURM3nJ5O9zmUgsBP0AtgsaZMrbuLHYgGw1XL3NvQ2kC2HQAjGNIUEaWqidTQ' },
        ].each do |article| %>
          <a href="/blog/<%= article[:slug] %>" class="flex flex-col bg-surface dark:bg-dark-surface rounded-xl overflow-hidden shadow-card hover:shadow-hover transition-all duration-200 group border border-border dark:border-dark-border">
            <div class="relative h-48 sm:h-52 overflow-hidden">
              <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="<%= article[:img] %>" alt="<%= article[:title] %>"/>
              <span class="absolute top-3 left-3 bg-white/90 dark:bg-dark-surface/90 backdrop-blur-md px-2.5 py-0.5 rounded-full text-[10px] sm:text-xs font-bold text-primary"><%= article[:tag] %></span>
            </div>
            <div class="p-4 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-1 text-text-muted dark:text-dark-text-sec text-[11px] mb-1.5">
                  <span class="material-symbols-outlined text-xs">calendar_today</span>
                  <%= article[:date] %> &bull; <%= article[:read] %>
                </div>
                <h3 class="text-sm sm:text-base font-bold text-text-primary dark:text-dark-text mb-1.5 group-hover:text-primary transition-colors line-clamp-2"><%= article[:title] %></h3>
                <p class="text-xs text-text-secondary dark:text-dark-text-sec line-clamp-2 mb-3"><%= article[:excerpt] %></p>
              </div>

              <div class="mt-auto pt-3 border-t border-border dark:border-dark-border flex justify-between items-center">
                <span class="text-xs font-bold text-primary">Leer artículo</span>
                <span class="material-symbols-outlined text-primary text-sm group-hover:translate-x-1 transition-transform">arrow_forward</span>
              </div>
            </div>
          </a>
        <% end %>
      </div>

      <!-- Pagination -->
      <div class="mt-6 flex justify-center items-center gap-2">
        <button class="w-8 h-8 rounded-lg border border-border dark:border-dark-border flex items-center justify-center text-text-secondary dark:text-dark-text-sec hover:border-primary hover:text-primary transition-colors">
          <span class="material-symbols-outlined text-sm">chevron_left</span>
        </button>
        <button class="w-8 h-8 rounded-lg bg-primary text-white flex items-center justify-center text-xs font-bold">1</button>
        <button class="w-8 h-8 rounded-lg border border-transparent hover:bg-surface dark:hover:bg-dark-surface flex items-center justify-center text-xs font-medium text-text-secondary dark:text-dark-text-sec transition-colors">2</button>
        <button class="w-8 h-8 rounded-lg border border-transparent hover:bg-surface dark:hover:bg-dark-surface flex items-center justify-center text-xs font-medium text-text-secondary dark:text-dark-text-sec transition-colors">3</button>
        <span class="text-text-muted dark:text-dark-text-sec text-xs">...</span>
        <button class="w-8 h-8 rounded-lg border border-border dark:border-dark-border flex items-center justify-center text-text-secondary dark:text-dark-text-sec hover:border-primary hover:text-primary transition-colors">
          <span class="material-symbols-outlined text-sm">chevron_right</span>
        </button>
      </div>
    </section>

    <!-- Newsletter Banner -->
    <section>
      <div class="bg-surface dark:bg-dark-surface p-5 sm:p-8 rounded-xl border border-border dark:border-dark-border flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-card">
        <div class="max-w-xl">
          <h2 class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text mb-1 font-poppins">No te pierdas ninguna historia desde el borde del descubrimiento.</h2>
          <p class="text-xs sm:text-sm text-text-secondary dark:text-dark-text-sec">Únete a más de 50,000 viajeros que reciben nuestras ideas semanales sobre IA y destinos exclusivos.</p>
        </div>
        <div class="flex w-full md:w-auto flex-col sm:flex-row gap-2 shrink-0">
          <input class="w-full sm:w-64 px-4 py-2.5 bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border rounded-xl text-xs sm:text-sm outline-none focus:ring-2 focus:ring-primary text-text-primary dark:text-dark-text placeholder:text-text-muted" placeholder="Ingresa tu email" type="email"/>
          <button class="w-full sm:w-auto bg-primary text-white px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold shadow-md hover:bg-primary-dark transition-all">Suscribirse</button>
        </div>
      </div>
    </section>
  </main>

  <div class="hidden lg:block lg:col-start-3 lg:row-start-2">
    <%= render partial: "shared/right_panel" %>
  </div>

</div>

<!-- Floating Mobile Navigation -->
<%= render partial: "shared/bottom_nav" %>
