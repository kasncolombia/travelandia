<%= render partial: "shared/head" %>

<div class="min-h-screen bg-background dark:bg-dark-bg flex flex-col lg:grid lg:grid-rows-[60px_1fr] lg:grid-cols-[260px_1fr_300px] xl:grid-cols-[280px_1fr_320px] lg:h-screen lg:overflow-hidden pb-16 lg:pb-0">

  <%= render partial: "shared/topbar" %>
  <%= render partial: "shared/sidebar" %>

  <!-- MAIN CONTENT - CATEGORIES INDEX -->
  <main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6 bg-background dark:bg-dark-bg lg:col-start-2 lg:row-start-2">
    <% icons = {
      'Playas' => '🏖️', 'Aventura' => '🧗', 'Ciudades' => '🏙️', 'Naturaleza' => '🌲',
      'Cultura' => '🏛️', 'Gastronomía' => '🍜', 'Lujo' => '💎', 'Ecoturismo' => '🌿',
      'Romántico' => '❤️', 'Familiar' => '👨‍👩‍👧‍👦', 'Mochilero' => '🎒', 'Bienestar' => '🧘'
    } %>

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
      <div>
        <h1 class="text-xl sm:text-2xl font-bold text-text-primary dark:text-dark-text font-poppins">Categorías de viaje</h1>
        <p class="text-xs sm:text-sm text-text-secondary dark:text-dark-text-sec mt-0.5"><%= @categories.size %> categorías para inspirar tu próxima aventura</p>
      </div>

      <div class="relative w-full sm:w-64">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-text-muted dark:text-dark-text-sec text-base">search</span>
        <input class="w-full pl-9 pr-4 py-2 bg-surface dark:bg-dark-surface border border-border dark:border-dark-border rounded-xl text-xs sm:text-sm outline-none focus:ring-2 focus:ring-primary text-text-primary dark:text-dark-text placeholder:text-text-muted" placeholder="Buscar categorías..." type="text"/>
      </div>
    </div>

    <!-- Category Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      <% @categories.each do |category| %>
        <% icon = icons[category.name] || '🌍' %>
        <%= link_to category_path(category.slug), class: "group bg-surface dark:bg-dark-surface rounded-xl border border-border dark:border-dark-border p-4 sm:p-5 hover:shadow-hover hover:-translate-y-0.5 transition-all duration-200" do %>
          <div class="flex items-start justify-between mb-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-lg bg-primary-light dark:bg-primary/20 flex items-center justify-center text-lg sm:text-xl group-hover:scale-110 transition-transform"><%= icon %></div>
              <div>
                <h2 class="font-bold text-text-primary dark:text-dark-text text-xs sm:text-sm group-hover:text-primary transition-colors"><%= category.name %></h2>
                <p class="text-[11px] text-text-muted dark:text-dark-text-sec"><%= pluralize(category.subcategories.size, 'subcategoría') %></p>
              </div>
            </div>
            <span class="material-symbols-outlined text-text-muted dark:text-dark-text-sec text-lg group-hover:translate-x-0.5 transition-transform">chevron_right</span>
          </div>

          <div class="flex flex-wrap gap-1.5">
            <% category.subcategories.first(4).each do |sub| %>
              <span class="text-[10px] sm:text-[11px] bg-gray-100 dark:bg-dark-bg text-text-secondary dark:text-dark-text-sec px-2 py-0.5 rounded-md"><%= sub.name %></span>
            <% end %>
            <% if category.subcategories.size > 4 %>
              <span class="text-[10px] sm:text-[11px] bg-gray-100 dark:bg-dark-bg text-text-muted dark:text-dark-text-sec px-2 py-0.5 rounded-md">+<%= category.subcategories.size - 4 %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </main>

  <div class="hidden lg:block lg:col-start-3 lg:row-start-2">
    <%= render partial: "shared/right_panel" %>
  </div>

</div>

<!-- Floating Mobile Navigation -->
<%= render partial: "shared/bottom_nav" %>
