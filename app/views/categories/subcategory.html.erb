<% content_for :head do %>
  <title><%= @subcategory.name %> - TravelIA | Guía completa de viaje</title>
  <meta name="description" content="Descubre todo sobre <%= @subcategory.name.downcase %>. Guía completa con mejores destinos, recomendaciones, clima, mejores épocas para viajar, alojamiento y más.">
  <meta property="og:title" content="<%= @subcategory.name %> - TravelIA">
  <meta property="og:description" content="Guía completa de <%= @subcategory.name.downcase %> con recomendaciones expertas para tu próximo viaje.">
  <meta property="og:type" content="website">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="<%= category_subcategory_url(@category.slug, @subcategory.slug) %>">
<% end %>

<%= render partial: "shared/head" %>

<div class="min-h-screen bg-background dark:bg-dark-bg flex flex-col lg:grid lg:grid-rows-[60px_1fr] lg:grid-cols-[260px_1fr_300px] xl:grid-cols-[280px_1fr_320px] lg:h-screen lg:overflow-hidden pb-16 lg:pb-0">

  <%= render partial: "shared/topbar" %>
  <%= render partial: "shared/sidebar" %>

  <!-- MAIN CONTENT - SUBCATEGORY DETAIL -->
  <main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6 bg-background dark:bg-dark-bg lg:col-start-2 lg:row-start-2">
    <% hero_images = {
      'Caribe Mexicano' => 'https://images.unsplash.com/photo-1510097467424-192d713fd8b1?w=1200&q=80',
      'Polinesia Francesa' => 'https://images.unsplash.com/photo-1507876466758-bc54f384809c?w=1200&q=80',
      'Costas de Tailandia' => 'https://images.unsplash.com/photo-1552465011-b4e21bf6e79a?w=1200&q=80',
      'Islas Griegas' => 'https://images.unsplash.com/photo-1533105079780-92b9be482077?w=1200&q=80',
      'Maldivas' => 'https://images.unsplash.com/photo-1514282401047-d79a71a590e8?w=1200&q=80',
      'Costa Amalfitana' => 'https://images.unsplash.com/photo-1534008897995-27a23e859048?w=1200&q=80',
      'Trekking en Patagonia' => 'https://images.unsplash.com/photo-1531366936337-7c912a4589a7?w=1200&q=80',
      'Auroras Boreales en Islandia' => 'https://images.unsplash.com/photo-1504214208698-ea1916a2195a?w=1200&q=80',
      'Safari en Kenia' => 'https://images.unsplash.com/photo-1516426122078-c23e76319801?w=1200&q=80',
      'Nueva York' => 'https://images.unsplash.com/photo-1496442226666-8d4d0e62e6e9?w=1200&q=80',
      'Tokio' => 'https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?w=1200&q=80',
      'París' => 'https://images.unsplash.com/photo-1502602898657-3e91760cbb34?w=1200&q=80',
      'Londres' => 'https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?w=1200&q=80',
      'Bangkok' => 'https://images.unsplash.com/photo-1508009603885-50cf7c579365?w=1200&q=80',
      'Dubái' => 'https://images.unsplash.com/photo-1512453979798-5ea266f8880c?w=1200&q=80',
      'Machu Picchu' => 'https://images.unsplash.com/photo-1587595431973-160d0d94add1?w=1200&q=80',
      'Taj Mahal' => 'https://images.unsplash.com/photo-1564507592333-c60657eea523?w=1200&q=80',
      'Gran Muralla China' => 'https://images.unsplash.com/photo-1508804185872-d7badad00f7d?w=1200&q=80',
    } %>
    <% hero = hero_images[@subcategory.name] || 'https://images.unsplash.com/photo-1488085061387-422e29b40080?w=1200&q=80' %>
    <% highlights = {
      'Caribe Mexicano' => { rating: '4.8', reviews: '12.4k', price: '$$', best_time: 'Dic-Abr', days: '7-10', vibe: 'Fiesta y relax' },
      'Polinesia Francesa' => { rating: '4.9', reviews: '8.1k', price: '$$$$', best_time: 'May-Oct', days: '10-14', vibe: 'Romántico' },
      'Costas de Tailandia' => { rating: '4.7', reviews: '15.2k', price: '$', best_time: 'Nov-Feb', days: '7-14', vibe: 'Aventura' },
      'Islas Griegas' => { rating: '4.8', reviews: '10.7k', price: '$$$', best_time: 'Jun-Sep', days: '5-10', vibe: 'Cultural' },
      'Maldivas' => { rating: '4.9', reviews: '9.3k', price: '$$$$', best_time: 'Nov-Abr', days: '5-7', vibe: 'Lujo' },
      'Costa Amalfitana' => { rating: '4.7', reviews: '7.8k', price: '$$$', best_time: 'Abr-Oct', days: '4-7', vibe: 'Romántico' },
      'Nueva York' => { rating: '4.8', reviews: '22.1k', price: '$$$', best_time: 'Sep-Nov', days: '4-7', vibe: 'Urbano' },
      'Tokio' => { rating: '4.9', reviews: '18.5k', price: '$$$', best_time: 'Mar-May', days: '7-10', vibe: 'Cultural' },
      'París' => { rating: '4.8', reviews: '20.3k', price: '$$$', best_time: 'Abr-Jun', days: '4-6', vibe: 'Romántico' },
      'Machu Picchu' => { rating: '4.7', reviews: '11.2k', price: '$$', best_time: 'May-Sep', days: '3-5', vibe: 'Aventura' },
    } %>
    <% info = highlights[@subcategory.name] || { rating: '4.7', reviews: '5.2k', price: '$$', best_time: 'Todo el año', days: '5-7', vibe: 'Variado' } %>
    <% descriptions = {
      'Caribe Mexicano' => 'El Caribe Mexicano es un paraíso tropical que baña las costas de Quintana Roo. Desde la energía vibrante de Cancún hasta la bohemia serena de Tulum y las cristalinas aguas de Cozumel.',
      'Polinesia Francesa' => 'Las islas de la Polinesia Francesa son el sueño de todo viajero. Bora Bora, Tahití y Moorea ofrecen paisajes de ensueño con aguas turquesa, arena blanca y lujosos resorts sobre el agua.',
      'Costas de Tailandia' => 'Tailandia cuenta con algunas de las playas más espectaculares del sudeste asiático. Koh Phi Phi, Railay Beach y las islas Similan son destinos imperdibles.',
      'Islas Griegas' => 'Las islas griegas del Egeo ofrecen un paisaje único de casas encaladas, cúpulas azules y atardeceres inolvidables. Santorini, Mykonos y Creta son el comienzo del viaje.',
      'Maldivas' => 'Las Maldivas son el epítome del lujo tropical. Con sus icónicos bungalows sobre el agua, arrecifes de coral vírgenes y una tranquilidad absoluta en el océano Índico.',
    } %>
    <% desc = descriptions[@subcategory.name] || "Descubre los mejores destinos y experiencias de #{@subcategory.name.downcase}. Una guía completa preparada por expertos viajeros." %>

    <!-- Breadcrumb -->
    <div class="flex items-center gap-1.5 text-xs sm:text-sm text-text-secondary dark:text-dark-text-sec">
      <a href="<%= categories_path %>" class="hover:text-primary transition-colors">Categorías</a>
      <span class="material-symbols-outlined text-xs sm:text-base text-text-muted">chevron_right</span>
      <a href="<%= category_path(@category.slug) %>" class="hover:text-primary transition-colors truncate"><%= @category.name %></a>
      <span class="material-symbols-outlined text-xs sm:text-base text-text-muted">chevron_right</span>
      <span class="text-text-primary dark:text-dark-text font-medium truncate"><%= @subcategory.name %></span>
    </div>

    <!-- Hero Header -->
    <section class="relative min-h-[300px] sm:h-[360px] lg:h-[400px] rounded-xl sm:rounded-2xl overflow-hidden shadow-card">
      <img class="w-full h-full object-cover" src="<%= hero %>" alt="<%= @subcategory.name %>"/>
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent"></div>
      <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-6 lg:p-8">
        <div class="flex flex-wrap items-center gap-2 mb-2 sm:mb-3">
          <span class="bg-primary text-white px-2.5 py-0.5 rounded-full text-[10px] sm:text-xs font-semibold uppercase tracking-wider"><%= @category.name %></span>
          <span class="bg-white/20 backdrop-blur-sm text-white px-2.5 py-0.5 rounded-full text-[10px] sm:text-xs font-semibold"><%= info[:vibe] %></span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white font-poppins max-w-3xl"><%= @subcategory.name %></h1>
        <p class="text-white/80 mt-1.5 max-w-2xl text-xs sm:text-sm line-clamp-2 sm:line-clamp-none"><%= desc.truncate(150) %></p>

        <div class="flex flex-wrap items-center gap-2 sm:gap-4 mt-4">
          <div class="flex items-center gap-1.5 bg-yellow-400/20 backdrop-blur-sm px-2.5 py-1 rounded-lg">
            <span class="text-yellow-300 text-xs sm:text-sm">★</span>
            <span class="text-white text-xs sm:text-sm font-bold"><%= info[:rating] %></span>
            <span class="text-white/70 text-[10px] sm:text-xs">(<%= info[:reviews] %>)</span>
          </div>
          <div class="flex items-center gap-1.5 bg-white/15 backdrop-blur-sm px-2.5 py-1 rounded-lg">
            <span class="material-symbols-outlined text-white text-xs sm:text-sm">schedule</span>
            <span class="text-white text-xs font-medium"><%= info[:best_time] %></span>
          </div>
          <div class="flex items-center gap-1.5 bg-white/15 backdrop-blur-sm px-2.5 py-1 rounded-lg">
            <span class="material-symbols-outlined text-white text-xs sm:text-sm">calendar_month</span>
            <span class="text-white text-xs font-medium"><%= info[:days] %> días</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
      <div class="bg-surface dark:bg-dark-surface rounded-xl border border-border dark:border-dark-border p-3.5 text-center hover:shadow-hover transition-shadow">
        <div class="w-8 h-8 rounded-full bg-primary-light dark:bg-primary/20 flex items-center justify-center mx-auto mb-1.5">
          <span class="material-symbols-outlined text-primary text-base">star</span>
        </div>
        <p class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text"><%= info[:rating] %></p>
        <p class="text-[11px] text-text-muted dark:text-dark-text-sec">Valoración</p>
      </div>

      <div class="bg-surface dark:bg-dark-surface rounded-xl border border-border dark:border-dark-border p-3.5 text-center hover:shadow-hover transition-shadow">
        <div class="w-8 h-8 rounded-full bg-primary-light dark:bg-primary/20 flex items-center justify-center mx-auto mb-1.5">
          <span class="material-symbols-outlined text-primary text-base">rate_review</span>
        </div>
        <p class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text"><%= info[:reviews] %></p>
        <p class="text-[11px] text-text-muted dark:text-dark-text-sec">Opiniones</p>
      </div>

      <div class="bg-surface dark:bg-dark-surface rounded-xl border border-border dark:border-dark-border p-3.5 text-center hover:shadow-hover transition-shadow">
        <div class="w-8 h-8 rounded-full bg-primary-light dark:bg-primary/20 flex items-center justify-center mx-auto mb-1.5">
          <span class="material-symbols-outlined text-primary text-base">payments</span>
        </div>
        <p class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text"><%= info[:price] %></p>
        <p class="text-[11px] text-text-muted dark:text-dark-text-sec">Presupuesto</p>
      </div>

      <div class="bg-surface dark:bg-dark-surface rounded-xl border border-border dark:border-dark-border p-3.5 text-center hover:shadow-hover transition-shadow">
        <div class="w-8 h-8 rounded-full bg-primary-light dark:bg-primary/20 flex items-center justify-center mx-auto mb-1.5">
          <span class="material-symbols-outlined text-primary text-base">calendar_month</span>
        </div>
        <p class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text"><%= info[:best_time] %></p>
        <p class="text-[11px] text-text-muted dark:text-dark-text-sec">Mejor época</p>
      </div>
    </div>

    <!-- Content & Sidebar Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-6 sm:gap-8">
      <div class="space-y-6">
        <!-- About -->
        <div class="bg-surface dark:bg-dark-surface rounded-xl border border-border dark:border-dark-border p-4 sm:p-6 shadow-card">
          <h2 class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text font-poppins mb-3">Acerca de <%= @subcategory.name.downcase %></h2>
          <p class="text-xs sm:text-sm text-text-secondary dark:text-dark-text-sec leading-relaxed"><%= desc %></p>
          <div class="flex flex-wrap gap-1.5 sm:gap-2 mt-4">
            <span class="bg-primary-light dark:bg-primary/20 text-primary text-xs font-semibold px-2.5 py-1 rounded-full">#Viajes</span>
            <span class="bg-primary-light dark:bg-primary/20 text-primary text-xs font-semibold px-2.5 py-1 rounded-full">#<%= @category.name.delete(' ').downcase %></span>
            <span class="bg-primary-light dark:bg-primary/20 text-primary text-xs font-semibold px-2.5 py-1 rounded-full">#<%= @subcategory.name.delete(' ').downcase %></span>
            <span class="bg-gray-100 dark:bg-dark-bg text-text-secondary dark:text-dark-text-sec text-xs px-2.5 py-1 rounded-full border border-border dark:border-dark-border">#TravelIA</span>
          </div>
        </div>

        <!-- Featured Destinations -->
        <div class="bg-surface dark:bg-dark-surface rounded-xl border border-border dark:border-dark-border p-4 sm:p-6 shadow-card">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text font-poppins">Destinos destacados</h2>
            <a href="/destinos" class="text-xs sm:text-sm text-primary font-bold hover:underline">Ver todos →</a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <% 4.times do |i| %>
              <div class="bg-gray-50 dark:bg-dark-bg rounded-xl border border-border dark:border-dark-border overflow-hidden hover:shadow-hover transition-shadow group cursor-pointer">
                <div class="h-32 sm:h-36 overflow-hidden">
                  <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=400&q=80" alt="Destino"/>
                </div>
                <div class="p-3.5">
                  <div class="flex items-center justify-between gap-2 mb-1">
                    <h3 class="font-bold text-text-primary dark:text-dark-text text-xs sm:text-sm truncate">Destino ejemplo <%= i + 1 %></h3>
                    <span class="text-yellow-500 text-xs font-bold shrink-0">★ <%= info[:rating] %></span>
                  </div>
                  <p class="text-xs text-text-muted dark:text-dark-text-sec line-clamp-2">Descubre este increíble destino con las mejores experiencias y actividades para tus próximas vacaciones.</p>
                  <div class="flex items-center justify-between mt-3 pt-2 border-t border-border dark:border-dark-border">
                    <span class="text-xs font-bold text-primary">Desde $XX</span>
                    <span class="text-[11px] text-text-muted dark:text-dark-text-sec flex items-center gap-1">
                      <span class="material-symbols-outlined text-xs">schedule</span>
                      <%= info[:days] %> días
                    </span>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Reviews -->
        <div class="bg-surface dark:bg-dark-surface rounded-xl border border-border dark:border-dark-border p-4 sm:p-6 shadow-card">
          <h2 class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text font-poppins mb-4">Lo que dicen los viajeros</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <% [
              { name: 'Laura M.', avatar: 'LM', text: 'Una experiencia increíble. Superó todas mis expectativas. Volvería una y otra vez.', rating: 5 },
              { name: 'Carlos R.', avatar: 'CR', text: 'Viaje perfectamente organizado. TravelIA me ayudó a descubrir lugares que nunca imaginé.', rating: 5 },
              { name: 'Ana S.', avatar: 'AS', text: 'Destino hermoso y muy bien recomendado. La guía fue súper útil para planificar.', rating: 4 },
              { name: 'Pedro G.', avatar: 'PG', text: 'Excelente relación calidad-precio. Muy contento con la experiencia.', rating: 5 },
            ].each do |review| %>
              <div class="bg-gray-50 dark:bg-dark-bg rounded-xl p-3.5 sm:p-4 border border-border dark:border-dark-border">
                <div class="flex items-center gap-0.5 mb-1.5">
                  <% review[:rating].times do %><span class="text-yellow-400 text-xs sm:text-sm">★</span><% end %>
                </div>
                <p class="text-xs sm:text-sm text-text-secondary dark:text-dark-text-sec leading-relaxed mb-3">"<%= review[:text] %>"</p>
                <div class="flex items-center gap-2">
                  <div class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center text-xs font-bold"><%= review[:avatar] %></div>
                  <span class="text-xs font-semibold text-text-primary dark:text-dark-text"><%= review[:name] %></span>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- FAQs -->
        <div class="bg-surface dark:bg-dark-surface rounded-xl border border-border dark:border-dark-border p-4 sm:p-6 shadow-card">
          <h2 class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text font-poppins mb-4">Preguntas frecuentes</h2>
          <div class="space-y-3">
            <% [
              { q: "¿Cuál es la mejor época para visitar #{@subcategory.name.downcase}?", a: "La mejor época para visitar #{@subcategory.name.downcase} es durante #{info[:best_time]}, cuando las condiciones climáticas son más favorables." },
              { q: "¿Cuántos días se recomienda para un viaje a #{@subcategory.name.downcase}?", a: "Recomendamos dedicar entre #{info[:days]} días para explorar #{@subcategory.name.downcase} a fondo." },
              { q: "¿Qué presupuesto necesito para viajar a #{@subcategory.name.downcase}?", a: "Generalmente se considera un rango de presupuesto #{info[:price]} por persona, incluyendo alojamiento, alimentación y actividades principales." },
            ].each do |faq| %>
              <details class="group bg-gray-50 dark:bg-dark-bg rounded-xl border border-border dark:border-dark-border">
                <summary class="flex items-center justify-between p-3.5 sm:p-4 cursor-pointer text-xs sm:text-sm font-semibold text-text-primary dark:text-dark-text hover:text-primary transition-colors list-none">
                  <span><%= faq[:q] %></span>
                  <span class="material-symbols-outlined text-text-muted dark:text-dark-text-sec group-open:rotate-180 transition-transform text-base ml-2 shrink-0">expand_more</span>
                </summary>
                <div class="px-3.5 pb-3.5 sm:px-4 sm:pb-4 text-xs sm:text-sm text-text-secondary dark:text-dark-text-sec leading-relaxed border-t border-border dark:border-dark-border pt-3"><%= faq[:a] %></div>
              </details>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="space-y-4">
        <div class="bg-surface dark:bg-dark-surface rounded-xl border border-border dark:border-dark-border p-4 sm:p-5 shadow-card">
          <h3 class="font-bold text-text-primary dark:text-dark-text text-xs sm:text-sm mb-3">Información útil</h3>
          <div class="space-y-3 text-xs sm:text-sm">
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary text-base">category</span>
              <div><span class="text-text-muted dark:text-dark-text-sec text-xs">Categoría</span><p class="text-text-primary dark:text-dark-text font-semibold"><%= @category.name %></p></div>
            </div>
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary text-base">layers</span>
              <div><span class="text-text-muted dark:text-dark-text-sec text-xs">Subcategorías</span><p class="text-text-primary dark:text-dark-text font-semibold"><%= @category.subcategories.size %> disponibles</p></div>
            </div>
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary text-base">public</span>
              <div><span class="text-text-muted dark:text-dark-text-sec text-xs">Disponibilidad</span><p class="text-text-primary dark:text-dark-text font-semibold">Todo el año</p></div>
            </div>
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary text-base">payments</span>
              <div><span class="text-text-muted dark:text-dark-text-sec text-xs">Presupuesto estimado</span><p class="text-text-primary dark:text-dark-text font-semibold"><%= info[:price] %></p></div>
            </div>
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-primary text-base">event</span>
              <div><span class="text-text-muted dark:text-dark-text-sec text-xs">Mejor época</span><p class="text-text-primary dark:text-dark-text font-semibold"><%= info[:best_time] %></p></div>
            </div>
          </div>
        </div>

        <div class="bg-gradient-to-br from-teal-900 via-teal-800 to-emerald-900 rounded-xl p-4 sm:p-5 text-white relative overflow-hidden shadow-card">
          <div class="relative z-10">
            <span class="material-symbols-outlined text-2xl sm:text-3xl mb-2 text-accent">auto_awesome</span>
            <h3 class="font-bold text-sm sm:text-base mb-1">Planifica con IA</h3>
            <p class="text-xs text-white/80 mb-4">Deja que TravelIA cree un itinerario personalizado para tu viaje a <%= @subcategory.name.downcase %>.</p>
            <a href="/planificador" class="w-full bg-white/20 backdrop-blur-sm text-white py-2.5 rounded-lg text-xs sm:text-sm font-semibold hover:bg-white/30 transition-colors border border-white/10 flex items-center justify-center gap-2">
              <span class="material-symbols-outlined text-sm">auto_awesome</span>
              Generar itinerario
            </a>
          </div>
        </div>
      </aside>
    </div>

    <!-- Related Subcategories -->
    <section class="pt-2">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text">Más de <%= @category.name.downcase %></h2>
          <p class="text-xs text-text-muted dark:text-dark-text-sec">Otras subcategorías que te pueden interesar</p>
        </div>
        <a href="<%= category_path(@category.slug) %>" class="text-xs sm:text-sm text-primary font-bold hover:underline flex items-center gap-1">Ver todas <span class="material-symbols-outlined text-xs sm:text-sm">arrow_forward</span></a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
        <% @sibling_subcategories.each do |sub| %>
          <%= link_to category_subcategory_path(@category.slug, sub.slug), class: "bg-surface dark:bg-dark-surface rounded-xl border border-border dark:border-dark-border p-3.5 hover:shadow-hover hover:border-primary/30 transition-all duration-200 group block" do %>
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-primary-light dark:bg-primary/20 text-primary flex items-center justify-center text-xs font-bold group-hover:scale-110 transition-transform shrink-0">▸</div>
              <div class="min-w-0 flex-1">
                <h3 class="font-semibold text-text-primary dark:text-dark-text text-xs sm:text-sm group-hover:text-primary transition-colors truncate"><%= sub.name %></h3>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>
  </main>

  <div class="hidden lg:block lg:col-start-3 lg:row-start-2">
    <%= render partial: "shared/right_panel" %>
  </div>

</div>

