<%= render partial: "shared/head" %>

<body class="bg-background dark:bg-dark-bg font-sans min-h-screen flex text-text-primary dark:text-dark-text">
  <main class="w-full min-h-screen flex flex-col lg:flex-row">
    <!-- Left Hero Image Carousel Section -->
    <section class="relative lg:w-[42%] min-h-[35vh] lg:min-h-screen overflow-hidden bg-gradient-to-br from-teal-900 via-teal-800 to-emerald-900 flex flex-col justify-between p-6 sm:p-8 lg:p-10">
      <div id="hero-slider" class="absolute inset-0 z-0">
        <div class="slide absolute inset-0 transition-opacity duration-700 opacity-100">
          <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1200&q=80"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
        </div>
        <div class="slide absolute inset-0 transition-opacity duration-700 opacity-0">
          <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1488085061387-422e29b40080?w=1200&q=80"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
        </div>
        <div class="slide absolute inset-0 transition-opacity duration-700 opacity-0">
          <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=1200&q=80"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
        </div>
      </div>

      <!-- Top Header Brand -->
      <div class="relative z-10">
        <a href="/" class="w-fit inline-block">
          <h1 class="text-2xl font-bold text-white flex items-center gap-2 drop-shadow-lg hover:opacity-80 transition-opacity font-poppins">
            <span class="text-xl">🌴</span> Travel<span class="text-teal-300">IA</span>
          </h1>
        </a>
      </div>

      <!-- Slider Testimonial Card -->
      <div id="slide-content" class="relative z-10 space-y-4 max-w-md my-auto pt-6 lg:pt-0">
        <div class="bg-white/10 backdrop-blur-md rounded-2xl p-5 sm:p-6 border border-white/15 space-y-3 shadow-card">
          <div class="flex gap-1">
            <span class="text-yellow-400 text-sm">★</span><span class="text-yellow-400 text-sm">★</span><span class="text-yellow-400 text-sm">★</span><span class="text-yellow-400 text-sm">★</span><span class="text-yellow-400 text-sm">★</span>
          </div>
          <p id="slide-quote" class="text-sm sm:text-base font-medium text-white leading-relaxed">"El planificador IA transformó mi viaje a los Dolomitas. Cada recomendación fue perfecta."</p>
          <div class="flex items-center gap-3 pt-1">
            <div id="slide-avatar" class="w-9 h-9 rounded-full bg-white/20 border border-white/40 flex items-center justify-center text-white font-bold text-xs">SJ</div>
            <div>
              <p id="slide-name" class="text-white font-bold text-xs sm:text-sm">Sarah Jenkins</p>
              <p id="slide-role" class="text-white/70 text-[10px] uppercase tracking-wider">Miembro Premium</p>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between pt-2">
          <div class="flex gap-3">
            <div class="bg-white/10 backdrop-blur-sm rounded-lg px-3 py-1.5 border border-white/10">
              <p class="text-white text-sm font-bold">+50k</p>
              <p class="text-white/70 text-[10px]">Viajeros</p>
            </div>
            <div class="bg-white/10 backdrop-blur-sm rounded-lg px-3 py-1.5 border border-white/10">
              <p class="text-white text-sm font-bold">4.9 ★</p>
              <p class="text-white/70 text-[10px]">Valoración</p>
            </div>
          </div>

          <div class="flex items-center gap-1.5">
            <button onclick="goSlide(0)" class="slider-dot w-2 h-2 rounded-full bg-white transition-all cursor-pointer"></button>
            <button onclick="goSlide(1)" class="slider-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white/80 transition-all cursor-pointer"></button>
            <button onclick="goSlide(2)" class="slider-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white/80 transition-all cursor-pointer"></button>
          </div>
        </div>
      </div>
    </section>

    <!-- Right Login Form Section -->
    <section class="flex-1 bg-surface dark:bg-dark-surface flex items-center justify-center p-6 sm:p-10 lg:p-12">
      <div class="w-full max-w-[420px] space-y-6">
        <!-- Logo Mobile -->
        <div class="lg:hidden flex items-center gap-2 mb-2">
          <a href="/" class="flex items-center gap-2">
            <span class="text-primary text-2xl">🌴</span>
            <h1 class="text-xl font-bold text-text-primary dark:text-dark-text font-poppins">Travel<span class="text-primary">IA</span></h1>
          </a>
        </div>

        <!-- Title -->
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-text-primary dark:text-dark-text font-poppins">Bienvenido de vuelta</h2>
          <p class="text-xs sm:text-sm text-text-secondary dark:text-dark-text-sec mt-1">Inicia sesión o entra como invitado para explorar.</p>
        </div>

        <!-- Alerts -->
        <% if flash[:alert] %>
          <div class="p-3 bg-rose-500/10 border border-rose-500/30 text-rose-600 dark:text-rose-400 text-xs font-semibold rounded-xl flex items-center gap-2">
            <span class="material-symbols-outlined text-base">error</span>
            <%= flash[:alert] %>
          </div>
        <% end %>

        <% if flash[:notice] %>
          <div class="p-3 bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-semibold rounded-xl flex items-center gap-2">
            <span class="material-symbols-outlined text-base">check_circle</span>
            <%= flash[:notice] %>
          </div>
        <% end %>

        <!-- Login Form -->
        <form action="/login" method="post" class="space-y-4">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

          <div class="space-y-3">
            <div>
              <label class="text-xs font-semibold text-text-muted dark:text-dark-text-sec ml-1">Correo electrónico</label>
              <div class="relative mt-1">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-text-muted dark:text-dark-text-sec text-base material-symbols-outlined">mail</span>
                <input name="email" required class="w-full h-11 pl-10 pr-4 bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border rounded-xl focus:ring-2 focus:ring-primary text-xs sm:text-sm outline-none text-text-primary dark:text-dark-text placeholder:text-text-muted" placeholder="tu-email@ejemplo.com" type="email"/>
              </div>
            </div>

            <div>
              <label class="text-xs font-semibold text-text-muted dark:text-dark-text-sec ml-1">Contraseña</label>
              <div class="relative mt-1">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-text-muted dark:text-dark-text-sec text-base material-symbols-outlined">lock</span>
                <input name="password" required class="w-full h-11 pl-10 pr-4 bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border rounded-xl focus:ring-2 focus:ring-primary text-xs sm:text-sm outline-none text-text-primary dark:text-dark-text placeholder:text-text-muted" placeholder="••••••••" type="password"/>
              </div>
            </div>
          </div>

          <div class="flex items-center justify-between text-xs">
            <label class="flex items-center gap-2 cursor-pointer">
              <input class="w-4 h-4 rounded border-gray-300 text-primary focus:ring-primary" type="checkbox" checked/>
              <span class="text-text-secondary dark:text-dark-text-sec">Recordarme</span>
            </label>
            <a class="text-primary font-bold hover:underline" href="#">¿Olvidaste tu contraseña?</a>
          </div>

          <button type="submit" class="w-full bg-primary text-white font-bold py-3 rounded-xl hover:bg-primary-dark transition-all shadow-md text-xs sm:text-sm cursor-pointer flex items-center justify-center gap-2">
            Iniciar sesión
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </button>
        </form>

        <!-- Guest Access Action Button (REQUIRED BY USER) -->
        <div class="p-4 bg-teal-500/10 dark:bg-teal-500/20 border border-teal-500/30 rounded-xl space-y-2 text-center">
          <p class="text-xs text-teal-800 dark:text-teal-200 font-medium">¿Quieres probar la plataforma sin registrarte?</p>
          <a href="/login/guest" class="w-full inline-flex items-center justify-center gap-2 bg-teal-700 dark:bg-teal-600 text-white font-bold py-2.5 px-4 rounded-lg text-xs sm:text-sm hover:bg-teal-800 transition-all shadow-sm">
            <span class="material-symbols-outlined text-base">visibility</span>
            Entrar como invitado
          </a>
        </div>

        <!-- Divider -->
        <div class="relative flex items-center">
          <div class="flex-grow border-t border-border dark:border-dark-border"></div>
          <span class="flex-shrink mx-4 text-xs text-text-muted dark:text-dark-text-sec">O continúa con</span>
          <div class="flex-grow border-t border-border dark:border-dark-border"></div>
        </div>

        <!-- Social logins -->
        <div class="grid grid-cols-2 gap-3">
          <a href="/login/guest" class="flex items-center justify-center gap-2 bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border py-2.5 rounded-xl hover:bg-gray-100 dark:hover:bg-dark-surface transition-all text-xs font-semibold text-text-primary dark:text-dark-text cursor-pointer">
            <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
            Google
          </a>
          <a href="/login/guest" class="flex items-center justify-center gap-2 bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border py-2.5 rounded-xl hover:bg-gray-100 dark:hover:bg-dark-surface transition-all text-xs font-semibold text-text-primary dark:text-dark-text cursor-pointer">
            <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C4.1 16.5 4.3 10.5 7.5 10.2c1.3.1 2 .8 2.8.8.8 0 1.9-.9 3.5-.8 1.4.1 2.5.6 3.2 1.6-2.9 1.7-2.4 5.6.5 6.8-.6 1.3-1.3 2.6-2.4 3.7zM12.03 9.4c-.1 0-.1 0 0 0 .1-2.2 1.8-4 4-4 .1 2.3-1.9 4.3-4 4z"/></svg>
            Apple
          </a>
        </div>

        <p class="text-center text-xs text-text-secondary dark:text-dark-text-sec">¿No tienes cuenta aún? <a class="text-primary font-bold hover:underline" href="/registro">Regístrate gratis</a></p>
      </div>
    </section>
  </main>

  <script>
    const slides = [
      { quote: '"El planificador IA transformó mi viaje a los Dolomitas. Cada recomendación fue perfecta."', name: 'Sarah Jenkins', role: 'Miembro Premium', initials: 'SJ' },
      { quote: '"Descubrí rincones de Tailandia que nunca habría encontrado sola. TravelIA es fabuloso."', name: 'María López', role: 'Viajera Frecuente', initials: 'ML' },
      { quote: '"Planifiqué mi luna de miel en 10 minutos. Los hoteles y actividades fueron espectaculares."', name: 'Carlos García', role: 'Miembro Premium', initials: 'CG' }
    ];
    let current = 0;
    setInterval(() => { goSlide((current + 1) % slides.length) }, 5000);
    function goSlide(i) {
      document.querySelectorAll('.slide')[current].classList.remove('opacity-100');
      document.querySelectorAll('.slide')[current].classList.add('opacity-0');
      document.querySelectorAll('.slider-dot')[current].classList.remove('bg-white');
      document.querySelectorAll('.slider-dot')[current].classList.add('bg-white/50');
      current = i;
      document.querySelectorAll('.slide')[current].classList.remove('opacity-0');
      document.querySelectorAll('.slide')[current].classList.add('opacity-100');
      document.querySelectorAll('.slider-dot')[current].classList.remove('bg-white/50');
      document.querySelectorAll('.slider-dot')[current].classList.add('bg-white');
      document.getElementById('slide-quote').textContent = slides[current].quote;
      document.getElementById('slide-name').textContent = slides[current].name;
      document.getElementById('slide-role').textContent = slides[current].role;
      document.getElementById('slide-avatar').textContent = slides[current].initials;
    }
  </script>
</body>
