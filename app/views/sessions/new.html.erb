<body class="bg-background font-sans min-h-screen flex">
  <main class="w-full min-h-screen flex flex-col lg:flex-row">
    <section class="relative lg:w-[38%] min-h-[40vh] lg:min-h-screen overflow-hidden bg-gradient-to-br from-teal-900 via-teal-800 to-emerald-900">
      <div id="hero-slider" class="absolute inset-0">
        <div class="slide absolute inset-0 transition-opacity duration-700 opacity-0">
          <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1200&q=80"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
        </div>
        <div class="slide absolute inset-0 transition-opacity duration-700 opacity-0">
          <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1488085061387-422e29b40080?w=1200&q=80"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
        </div>
        <div class="slide absolute inset-0 transition-opacity duration-700 opacity-0">
          <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=1200&q=80"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
        </div>
        <div class="slide absolute inset-0 transition-opacity duration-700 opacity-0">
          <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1530789253388-582c481c54b0?w=1200&q=80"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
        </div>
      </div>
      <div class="relative h-full flex flex-col justify-between p-8 lg:p-10 z-10">
        <a href="/" class="w-fit">
          <h1 class="text-2xl font-bold text-white flex items-center gap-2 drop-shadow-lg hover:opacity-80 transition-opacity">
            <span class="text-xl">🌴</span> Travel<span class="text-teal-300">IA</span>
          </h1>
        </a>
        <div id="slide-content" class="space-y-6 max-w-md">
          <div class="space-y-4">
            <div class="flex gap-1 mb-2">
              <span class="text-yellow-400 text-lg">★</span><span class="text-yellow-400 text-lg">★</span><span class="text-yellow-400 text-lg">★</span><span class="text-yellow-400 text-lg">★</span><span class="text-yellow-400 text-lg">★</span>
            </div>
            <p id="slide-quote" class="text-xl lg:text-2xl font-semibold text-white leading-tight">"El planificador IA transformó mi viaje a los Dolomitas. Cada recomendación fue perfecta."</p>
            <div class="flex items-center gap-3">
              <div id="slide-avatar" class="w-10 h-10 rounded-full bg-white/20 border-2 border-white/30 flex items-center justify-center text-white font-bold text-sm">SJ</div>
              <div>
                <p id="slide-name" class="text-white font-semibold text-sm">Sarah Jenkins</p>
                <p id="slide-role" class="text-white/60 text-xs uppercase tracking-wider">Miembro Premium</p>
              </div>
            </div>
          </div>
          <div class="flex gap-4 pt-2">
            <div class="bg-white/10 backdrop-blur-sm rounded-lg px-4 py-2 border border-white/10">
              <p class="text-white text-lg font-bold">+50k</p>
              <p class="text-white/60 text-xs">Viajeros</p>
            </div>
            <div class="bg-white/10 backdrop-blur-sm rounded-lg px-4 py-2 border border-white/10">
              <p class="text-white text-lg font-bold">4.9</p>
              <p class="text-white/60 text-xs">Valoración</p>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="goSlide(0)" class="slider-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white/80 transition-all cursor-pointer"></button>
          <button onclick="goSlide(1)" class="slider-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white/80 transition-all cursor-pointer"></button>
          <button onclick="goSlide(2)" class="slider-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white/80 transition-all cursor-pointer"></button>
          <button onclick="goSlide(3)" class="slider-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white/80 transition-all cursor-pointer"></button>
        </div>
      </div>
    </section>
    <section class="flex-1 bg-surface flex items-center justify-center px-6 py-8 lg:py-0">
      <div class="w-full max-w-[420px] space-y-6">
        <div class="lg:hidden flex items-center gap-2 mb-4">
          <a href="/" class="flex items-center gap-2">
            <span class="text-teal-600 text-xl">🌴</span>
            <h1 class="text-xl font-bold text-gray-900">Travel<span class="text-primary">IA</span></h1>
          </a>
        </div>
        <div>
          <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-poppins">Bienvenido de vuelta</h2>
          <p class="text-gray-500 mt-1">Inicia sesión para seguir explorando.</p>
        </div>
        <form class="space-y-4">
          <div class="space-y-3">
            <div>
              <label class="text-sm font-medium text-gray-600 ml-1">Correo electrónico</label>
              <div class="relative mt-1">
                <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400 text-lg material-symbols-outlined">mail</span>
                <input class="w-full h-12 pl-11 pr-4 bg-gray-100 border-none rounded-xl focus:ring-2 focus:ring-primary text-base outline-none text-gray-800 placeholder:text-gray-400" placeholder="nombre@ejemplo.com" type="email"/>
              </div>
            </div>
            <div>
              <label class="text-sm font-medium text-gray-600 ml-1">Contraseña</label>
              <div class="relative mt-1">
                <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400 text-lg material-symbols-outlined">lock</span>
                <input class="w-full h-12 pl-11 pr-4 bg-gray-100 border-none rounded-xl focus:ring-2 focus:ring-primary text-base outline-none text-gray-800 placeholder:text-gray-400" placeholder="••••••••" type="password"/>
              </div>
            </div>
          </div>
          <div class="flex items-center justify-between text-sm">
            <label class="flex items-center gap-2 cursor-pointer">
              <input class="w-4 h-4 rounded border-gray-300 text-primary focus:ring-primary" type="checkbox"/>
              <span class="text-gray-500">Recordarme</span>
            </label>
            <a class="text-primary font-semibold hover:underline text-sm" href="#">¿Olvidaste tu contraseña?</a>
          </div>
          <button class="w-full bg-primary text-white font-semibold py-3.5 rounded-xl hover:bg-teal-700 transition-all shadow-md text-base cursor-pointer flex items-center justify-center gap-2">
            Iniciar sesión
            <span class="material-symbols-outlined text-lg">arrow_forward</span>
          </button>
        </form>
        <div class="relative flex items-center">
          <div class="flex-grow border-t border-gray-200"></div>
          <span class="flex-shrink mx-4 text-sm text-gray-400">O continúa con</span>
          <div class="flex-grow border-t border-gray-200"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <button class="flex items-center justify-center gap-2.5 bg-white border border-gray-200 py-3 rounded-xl hover:bg-gray-50 hover:border-gray-300 transition-all text-sm font-medium text-gray-700 cursor-pointer">
            <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
            Google
          </button>
          <button class="flex items-center justify-center gap-2.5 bg-white border border-gray-200 py-3 rounded-xl hover:bg-gray-50 hover:border-gray-300 transition-all text-sm font-medium text-gray-700 cursor-pointer">
            <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C4.1 16.5 4.3 10.5 7.5 10.2c1.3.1 2 .8 2.8.8.8 0 1.9-.9 3.5-.8 1.4.1 2.5.6 3.2 1.6-2.9 1.7-2.4 5.6.5 6.8-.6 1.3-1.3 2.6-2.4 3.7zM12.03 9.4c-.1 0-.1 0 0 0 .1-2.2 1.8-4 4-4 .1 2.3-1.9 4.3-4 4z"/></svg>
            Apple
          </button>
        </div>
        <p class="text-center text-sm text-gray-500">¿No tienes cuenta? <a class="text-primary font-bold hover:underline" href="/registro">Únete a TravelIA</a></p>
      </div>
    </section>
  </main>
</body>
<script>
  const slides = [
    {
      img: 0,
      quote: '"El planificador IA transformó mi viaje a los Dolomitas. Cada recomendación fue perfecta."',
      initials: 'SJ', name: 'Sarah Jenkins', role: 'Miembro Premium'
    },
    {
      img: 1,
      quote: '"Descubrí rincones de Tailandia que nunca habría encontrado sola. TravelIA es como tener un amigo local."',
      initials: 'ML', name: 'María López', role: 'Viajera Frecuente'
    },
    {
      img: 2,
      quote: '"Planifiqué mi luna de miel en 10 minutos. Los hoteles y actividades fueron exactamente lo que soñábamos."',
      initials: 'CG', name: 'Carlos García', role: 'Miembro Premium'
    },
    {
      img: 3,
      quote: '"La ruta por Islandia que me armó la IA superó todas mis expectativas. Viaje inolvidable."',
      initials: 'AK', name: 'Ana Krüger', role: 'Exploradora'
    }
  ];
  let current = 0;
  const interval = setInterval(() => { goSlide((current + 1) % slides.length) }, 5000);
  function goSlide(i) {
    document.querySelectorAll('.slide')[current].classList.remove('opacity-100');
    document.querySelectorAll('.slide')[current].classList.add('opacity-0');
    document.querySelectorAll('.slider-dot')[current].classList.remove('bg-white');
    document.querySelectorAll('.slider-dot')[current].classList.add('bg-white/50');
    current = i;
    document.querySelectorAll('.slide')[current].classList.remove('opacity-0');
    document.querySelectorAll('.slide')[current].classList.add('opacity-100');
    document.querySelectorAll('.slider-dot')[current].classList.remove('bg-white/50');
    document.querySelectorAll('.slider-dot')[current].classList.add('bg-white');
    document.getElementById('slide-quote').textContent = slides[current].quote;
    document.getElementById('slide-name').textContent = slides[current].name;
    document.getElementById('slide-role').textContent = slides[current].role;
    document.getElementById('slide-avatar').textContent = slides[current].initials;
  }
  document.querySelectorAll('.slide')[0].classList.add('opacity-100');
  document.querySelectorAll('.slider-dot')[0].classList.add('bg-white');
</script>
