<%= render partial: "shared/head" %>

<div class="min-h-screen bg-background dark:bg-dark-bg flex flex-col lg:grid lg:grid-rows-[60px_1fr] lg:grid-cols-[260px_1fr_300px] xl:grid-cols-[280px_1fr_320px] lg:h-screen lg:overflow-hidden pb-16 lg:pb-0">

  <%= render partial: "shared/topbar" %>
  <%= render partial: "shared/sidebar" %>

  <!-- MAIN CONTENT AREA -->
  <main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6 bg-background dark:bg-dark-bg lg:col-start-2 lg:row-start-2">
    <!-- Hero Banner -->
    <section class="relative min-h-[220px] sm:h-64 rounded-xl sm:rounded-2xl overflow-hidden bg-cover bg-center shadow-card" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAeTTP3F4Ila_HqFywPakWizTC4J1mCYuohQiKQLu7buj0j1qMhK_FRwGQijMxl6DDMWVR6EpzlWRNBAIBIzf6uK97vKtApELIDH78jCN3FyD3x2BldT86NU9yfIyJMQN49DFVDmuJPRS-GbzFSu7748tk97EJ_Ql6PFLiimE1On1gCRX0kmT3Pn1RjoxOZ4dvKyO45bxdG56UQX31STpfbNess-xCOsgvrwwcMFssPd7Q0tpZ4hYU7Zbt0Mede4k2kNtLOzjKNTDc2');">
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
      <div class="relative h-full flex flex-col justify-center p-5 sm:p-8 lg:p-10 text-white">
        <span class="inline-block self-start bg-primary/80 backdrop-blur-xs text-white text-[10px] sm:text-xs font-bold px-2.5 py-1 rounded-full mb-2">✨ ASISTENTE IA DE VIAJES</span>
        <h2 class="text-xl sm:text-2xl lg:text-3xl font-bold leading-tight font-poppins">Descubre el mundo<br/>a tu manera</h2>
        <p class="mt-1.5 text-xs sm:text-sm lg:text-base max-w-md opacity-90 leading-relaxed">Planifica viajes perfectos con IA, encuentra las mejores ofertas y vive experiencias inolvidables.</p>
        <div class="mt-4 sm:mt-6 flex flex-col sm:flex-row gap-2.5 sm:gap-3">
          <a href="/planificador" class="w-full sm:w-auto bg-primary hover:bg-primary-dark text-white px-5 py-2.5 sm:px-6 sm:py-3 rounded-lg text-xs sm:text-sm font-semibold transition-all flex items-center justify-center gap-2 shadow-md">✨ Planear viaje con IA</a>
          <a href="/destinos" class="w-full sm:w-auto bg-white/90 dark:bg-dark-surface/90 hover:bg-white dark:hover:bg-dark-surface text-text-primary dark:text-dark-text px-5 py-2.5 sm:px-6 sm:py-3 rounded-lg text-xs sm:text-sm font-semibold backdrop-blur-sm text-center transition-all">Explorar destinos</a>
        </div>
      </div>
    </section>

    <!-- Quick Actions Carousel -->
    <section>
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm sm:text-base font-bold text-text-primary dark:text-dark-text">Servicios rápidos</h3>
        <span class="text-xs text-text-muted dark:text-dark-text-sec">Desliza para ver más →</span>
      </div>
      <div class="flex gap-2.5 sm:gap-3 overflow-x-auto no-scrollbar py-1.5 -mx-4 px-4 sm:mx-0 sm:px-0 snap-x">
        <% [
          ['✈️','Vuelos','/destinos'],
          ['🏨','Hoteles','/hoteles'],
          ['🎁','Paquetes','/categories'],
          ['📷','Actividades','/categories'],
          ['🚗','Autos','/destinos'],
          ['🛡️','Seguros','/perfil'],
          ['🧭','Guías','/blog']
        ].each do |icon, label, url| %>
          <a href="<%= url %>" class="min-w-[85px] sm:min-w-[100px] bg-surface dark:bg-dark-surface p-3 sm:p-4 rounded-xl border border-border dark:border-dark-border flex flex-col items-center gap-1.5 cursor-pointer hover:border-primary hover:-translate-y-0.5 hover:shadow-card transition-all duration-200 snap-start group">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg bg-gray-50 dark:bg-dark-bg flex items-center justify-center text-lg sm:text-xl group-hover:bg-primary-light dark:group-hover:bg-primary/20 transition-colors"><%= icon %></div>
            <span class="text-xs font-semibold text-text-secondary dark:text-dark-text-sec text-center group-hover:text-primary transition-colors"><%= label %></span>
          </a>
        <% end %>
      </div>
    </section>

    <!-- Row: Trip + AI Planner -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6">
      <!-- Mi próximo viaje -->
      <section class="flex flex-col">
        <div class="flex justify-between items-center mb-3">
          <h3 class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text">Mi próximo viaje</h3>
          <a class="text-xs sm:text-sm text-primary font-semibold hover:underline" href="/planificador">Ver itinerario →</a>
        </div>
        <div class="flex-1 bg-surface dark:bg-dark-surface p-4 sm:p-5 rounded-xl border border-border dark:border-dark-border shadow-card flex flex-col justify-between">
          <div>
            <div class="flex gap-3 sm:gap-4">
              <img class="w-16 h-16 sm:w-20 sm:h-20 rounded-lg object-cover" src="https://images.unsplash.com/photo-1506665531195-3566af2b4dfa?w=200&q=80" alt="Tailandia"/>
              <div class="flex-1 min-w-0">
                <h4 class="text-sm sm:text-base font-bold text-text-primary dark:text-dark-text truncate">Tailandia Mágica</h4>
                <p class="text-xs text-text-muted dark:text-dark-text-sec mt-0.5">En 12 días • 24 Jun - 05 Jul</p>
                <div class="flex flex-wrap gap-2 mt-2 text-xs text-text-secondary dark:text-dark-text-sec">
                  <span class="bg-gray-100 dark:bg-dark-bg px-2 py-0.5 rounded">🕒 7 días</span>
                  <span class="bg-gray-100 dark:bg-dark-bg px-2 py-0.5 rounded">👥 2 pers</span>
                  <span class="bg-gray-100 dark:bg-dark-bg px-2 py-0.5 rounded">🏔️ Aventura</span>
                </div>
              </div>
            </div>

            <div class="mt-4">
              <div class="flex justify-between text-xs sm:text-sm mb-1">
                <span class="text-text-secondary dark:text-dark-text-sec">Progreso del viaje</span>
                <span class="font-bold text-primary">75%</span>
              </div>
              <div class="w-full bg-gray-100 dark:bg-dark-border h-2 rounded-full overflow-hidden">
                <div class="bg-primary h-2 rounded-full transition-all duration-500" style="width:75%"></div>
              </div>
            </div>

            <ul class="mt-4 space-y-2 text-xs sm:text-sm">
              <li class="flex items-center gap-2 text-green-600 dark:text-green-400 font-medium">✅ Vuelos confirmados</li>
              <li class="flex items-center gap-2 text-green-600 dark:text-green-400 font-medium">✅ Hotel reservado</li>
              <li class="flex items-center justify-between text-text-muted dark:text-dark-text-sec"><div class="flex items-center gap-2">⚪ Actividades pendientes</div><span class="font-medium">2/4</span></li>
              <li class="flex items-center justify-between text-text-muted dark:text-dark-text-sec"><div class="flex items-center gap-2">⚪ Documentos listos</div><span class="font-medium">3/4</span></li>
            </ul>
          </div>

          <a href="/planificador" class="w-full text-center mt-4 py-2.5 border border-border dark:border-dark-border rounded-lg text-xs sm:text-sm font-semibold text-text-secondary dark:text-dark-text-sec hover:bg-gray-50 dark:hover:bg-dark-border transition-colors block">Ver itinerario completo</a>
        </div>
      </section>

      <!-- Planificador IA -->
      <section class="flex flex-col">
        <div class="flex justify-between items-center mb-3">
          <h3 class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text">Planificador IA</h3>
          <a class="text-xs sm:text-sm text-primary font-semibold hover:underline" href="/planificador">Nuevo viaje +</a>
        </div>
        <div class="flex-1 bg-surface dark:bg-dark-surface p-4 sm:p-5 rounded-xl border border-border dark:border-dark-border shadow-card space-y-3.5 sm:space-y-4">
          <div>
            <label class="text-xs sm:text-sm font-semibold text-text-secondary dark:text-dark-text-sec">¿A dónde quieres viajar?</label>
            <input class="w-full mt-1.5 border border-border dark:border-dark-border rounded-lg text-xs sm:text-sm px-3.5 py-2.5 bg-gray-50 dark:bg-dark-bg outline-none focus:ring-2 focus:ring-primary placeholder:text-text-muted dark:placeholder:text-dark-text-sec text-text-primary dark:text-dark-text" placeholder="Ej: 5 días en Italia con presupuesto medio"/>
          </div>

          <div>
            <p class="text-xs sm:text-sm font-semibold text-text-secondary dark:text-dark-text-sec mb-2">Estilo de viaje</p>
            <div class="flex flex-wrap gap-1.5 sm:gap-2">
              <span class="bg-primary text-white px-2.5 py-1 rounded-full text-xs font-medium cursor-pointer">💎 Económico</span>
              <span class="bg-gray-100 dark:bg-dark-bg text-text-secondary dark:text-dark-text-sec px-2.5 py-1 rounded-full text-xs font-medium cursor-pointer hover:bg-primary-light hover:text-primary transition-colors">🧗 Aventura</span>
              <span class="bg-gray-100 dark:bg-dark-bg text-text-secondary dark:text-dark-text-sec px-2.5 py-1 rounded-full text-xs font-medium cursor-pointer hover:bg-primary-light hover:text-primary transition-colors">❤️ Romántico</span>
              <span class="bg-gray-100 dark:bg-dark-bg text-text-secondary dark:text-dark-text-sec px-2.5 py-1 rounded-full text-xs font-medium cursor-pointer hover:bg-primary-light hover:text-primary transition-colors">👨‍👩‍👧‍👦 Familiar</span>
              <span class="bg-gray-100 dark:bg-dark-bg text-text-secondary dark:text-dark-text-sec px-2.5 py-1 rounded-full text-xs font-medium cursor-pointer hover:bg-primary-light hover:text-primary transition-colors">👑 Lujo</span>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="text-xs font-semibold text-text-secondary dark:text-dark-text-sec">Duración</label>
              <div class="flex items-center mt-1 bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border rounded-lg">
                <button type="button" class="text-text-muted px-2.5 py-1.5 text-sm font-bold hover:text-text-primary dark:hover:text-dark-text">−</button>
                <span class="flex-1 text-center text-xs sm:text-sm font-medium text-text-primary dark:text-dark-text">5 días</span>
                <button type="button" class="text-text-muted px-2.5 py-1.5 text-sm font-bold hover:text-text-primary dark:hover:text-dark-text">+</button>
              </div>
            </div>
            <div>
              <label class="text-xs font-semibold text-text-secondary dark:text-dark-text-sec">Presupuesto</label>
              <div class="flex items-center mt-1 bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border rounded-lg">
                <button type="button" class="text-text-muted px-2.5 py-1.5 text-sm font-bold hover:text-text-primary dark:hover:text-dark-text">−</button>
                <span class="flex-1 text-center text-xs sm:text-sm font-medium text-text-primary dark:text-dark-text">Medio</span>
                <button type="button" class="text-text-muted px-2.5 py-1.5 text-sm font-bold hover:text-text-primary dark:hover:text-dark-text">+</button>
              </div>
            </div>
          </div>

          <a href="/planificador" class="w-full bg-primary text-white py-3 rounded-lg text-xs sm:text-sm font-bold hover:bg-primary-dark transition-all shadow-card flex items-center justify-center gap-2 block text-center">✨ Generar mi viaje con IA</a>
        </div>
      </section>
    </div>

    <!-- Destinos Populares Grid -->
    <section>
      <div class="flex justify-between items-center mb-3 sm:mb-4">
        <h3 class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text">Destinos populares</h3>
        <a class="text-xs sm:text-sm text-primary font-semibold hover:underline" href="/destinos">Ver todos →</a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-4">
        <% [['Bali','Indonesia','4.8','$4.120.000','https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=400&q=80'],['París','Francia','4.7','$3.250.000','https://images.unsplash.com/photo-1502602898657-3e91760cbb34?w=400&q=80'],['Cancún','México','4.6','$2.100.000','https://images.unsplash.com/photo-1506953823976-52e1fdc0149a?w=400&q=80'],['Tokio','Japón','4.9','$5.890.000','https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?w=400&q=80'],['Dubái','EAU','4.7','$4.990.000','https://images.unsplash.com/photo-1512453979798-5ea266f8880c?w=400&q=80']].each do |name, country, rating, price, img| %>
          <a href="/destinos" class="cursor-pointer group bg-surface dark:bg-dark-surface p-2 sm:p-2.5 rounded-xl border border-border dark:border-dark-border hover:shadow-hover transition-all block">
            <div class="relative rounded-lg overflow-hidden aspect-[4/3]">
              <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" src="<%= img %>" alt="<%= name %>"/>
              <span class="absolute top-1.5 right-1.5 text-white/90 text-sm sm:text-base drop-shadow-md">🤍</span>
              <span class="absolute bottom-1.5 left-1.5 bg-white/90 dark:bg-dark-surface/90 text-text-primary dark:text-dark-text text-[10px] sm:text-xs font-bold px-1.5 py-0.5 rounded">⭐ <%= rating %></span>
            </div>
            <div class="mt-2 px-0.5">
              <p class="text-xs sm:text-sm font-bold text-text-primary dark:text-dark-text truncate"><%= name %></p>
              <p class="text-[11px] text-text-muted dark:text-dark-text-sec truncate"><%= country %></p>
              <p class="text-xs sm:text-sm font-bold text-primary mt-1">Desde <%= price %></p>
            </div>
          </a>
        <% end %>
      </div>
    </section>

    <!-- Categorías Inspiración -->
    <section>
      <div class="flex justify-between items-center mb-3 sm:mb-4">
        <h3 class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text">Categorías de inspiración</h3>
        <a class="text-xs sm:text-sm text-primary font-semibold hover:underline" href="/categories">Ver todas →</a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
        <% [['Playas','124','https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=400&q=80'],['Aventura','86','https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=400&q=80'],['Ciudades','212','https://images.unsplash.com/photo-1477959858617-67f85cf4f1df?w=400&q=80'],['Naturaleza','153','https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=400&q=80']].each do |cat, count, img| %>
          <a href="/categories" class="h-20 sm:h-24 rounded-xl overflow-hidden relative cursor-pointer group shadow-card block">
            <img class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" src="<%= img %>" alt="<%= cat %>"/>
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent flex flex-col justify-end p-3">
              <p class="text-sm sm:text-base text-white font-bold"><%= cat %></p>
              <p class="text-xs text-white/80"><%= count %> destinos</p>
            </div>
          </a>
        <% end %>
      </div>
    </section>

    <!-- Mobile-only Widgets Section (Parity with Desktop Right Panel) -->
    <section class="lg:hidden pt-4 border-t border-border dark:border-dark-border">
      <h3 class="text-base font-bold text-text-primary dark:text-dark-text mb-4">Información &amp; Herramientas</h3>
      <%= render partial: "shared/right_panel" %>
    </section>
  </main>

  <!-- Desktop Right Panel -->
  <div class="hidden lg:block lg:col-start-3 lg:row-start-2">
    <%= render partial: "shared/right_panel" %>
  </div>

</div>

<!-- Floating Mobile Navigation -->
<%= render partial: "shared/bottom_nav" %>
