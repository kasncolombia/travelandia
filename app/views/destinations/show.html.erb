        <button class="material-symbols-outlined p-1.5 border border-border rounded-full hover:bg-surface transition-all">chevron_right</button>
      </div>
    </div>
    <div class="flex gap-6 overflow-x-auto no-scrollbar pb-6 -mx-4 px-4">
      <!-- Activity 1 -->
      <div class="min-w-[320px] bg-surface rounded-lg overflow-hidden shadow-card hover:shadow-md transition-shadow group border border-border">
        <div class="h-48 relative overflow-hidden">
          <img alt="Surf Uluwatu" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC0Auob3HpTnoQUvLUJM954medMlzqiA7jTuS57skRKIC528avXyuFYpBkd7kkTPcCPgU5y1Be82972P1UI2_BhFmvvFExDqlUE9G_lrDxMBhmatTsh0TSTqBbYcIHlNaCe4wqaDLoRKcxH7EltR6YywK4YGl6SM-44aom9dEJg1YLEfUDVf21-ssIiBnnoyxzTwCwyynxDezRlWZEJxPTI8m5jZdHa3UFwmeOpLWQzPGZLHVkv2zT2oYrfcgf4Jfn65Lr6rxHZfAJC"/>
          <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-md px-3 py-1 rounded-full text-sm font-bold text-primary">Aventura</span>
        </div>
        <div class="p-5">
