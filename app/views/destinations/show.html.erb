            <span class="text-primary font-bold">$45 / persona</span>
            <button class="text-primary text-sm flex items-center gap-1">Detalles <span class="material-symbols-outlined text-sm">arrow_forward</span></button>
          </div>
        </div>
      </div>
      <!-- Activity 2 -->
      <div class="min-w-[320px] bg-surface rounded-lg overflow-hidden shadow-card hover:shadow-md transition-shadow group border border-border">
        <div class="h-48 relative overflow-hidden">
          <img alt="Yoga Ubud" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAUhYGoqif_FskVHCDUC0d6h9f1sT33X_1Ud7KR5NiKkLNb2vOVRGmoJsV83g49ThlupTkxWE6rNpp5w-M5zT-ZfXYAePI1IrzrHfsksiaGdmFWc5T-H-KGT82eX5RyFAX5d-jKVAVvT49yBiUojppVYBTrTewjRetfk_i_d81XZSrjCyUrjNdEs3XEqUl0WMELNFJ8g2vewJoAk04m5Qs2ty_ikuFZpyhdS27NyORCjELQi5n6S2N6oTbOX-u1LqtN3CxisdVyW4Gl"/>
          <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-md px-3 py-1 rounded-full text-sm font-bold text-primary">Bienestar</span>
        </div>
        <div class="p-5">
          <h3 class="font-headline-lg text-lg mb-1">Retiro de Yoga en Ubud</h3>
          <p class="text-sm text-text-secondary mb-4">Encuentra paz interior en el corazón de la jungla.</p>
          <div class="flex justify-between items-center">
            <span class="text-primary font-bold">$30 / sesión</span>
            <button class="text-primary text-sm flex items-center gap-1">Detalles <span class="material-symbols-outlined text-sm">arrow_forward</span></button>
          </div>
        </div>
      </div>
      <!-- Activity 3 -->
      <div class="min-w-[320px] bg-surface rounded-lg overflow-hidden shadow-card hover:shadow-md transition-shadow group border border-border">
        <div class="h-48 relative overflow-hidden">
          <img alt="Clase de Cocina" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAUt4QDqDHYH9tCBjeJK9AP6mAZEx3q3KltCx9awc23gZOCrHsvr9RjKqgxDwOMSRmC_0KzwXqJibuxOyj_ZBOD1IV9KYOWHy17nHR7gn8GAzuQciCVhmIIe_a7TnpF8NQ7Nek2iIm7aPPQNC0ZikKtrp47pNjOmtgavpjl6JDUqr9nu3DPJZWoj2GPPpcFX6lSgR9o0Wrxf_RyrhKGob2LO2t7JNgoNMohd1eSvbk9rac9ex71LGU15fXndTuZe6aonZtELCiafzmn"/>
          <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-md px-3 py-1 rounded-full text-sm font-bold text-primary">Cultura</span>
        </div>
        <div class="p-5">
          <h3 class="font-headline-lg text-lg mb-1">Clase de Cocina Balinesa</h3>
          <p class="text-sm text-text-secondary mb-4">Domina el arte de las especias tradicionales indonesias.</p>
          <div class="flex justify-between items-center">
            <span class="text-primary font-bold">$55 / persona</span>
            <button class="text-primary text-sm flex items-center gap-1">Detalles <span class="material-symbols-outlined text-sm">arrow_forward</span></button>
          </div>
        </div>
      </div>
    </div>

    <!-- RECOMMENDED STAYS -->
    <h2 class="font-headline-xl text-headline-xl text-text-primary">Estancias Recomendadas</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="flex gap-4 bg-surface p-4 rounded-lg border border-border shadow-card hover:shadow-md transition-all group">
        <div class="w-32 h-32 rounded-lg overflow-hidden shrink-0">
          <img alt="Viceroy Bali" class="w-full h-full object-cover group-hover:scale-105 transition-transform" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCqVfeeG439e1bOalUQXtSVEcw_ib-3e0h2jdlfesw4htYD6Pul9qBQSbeI8YB_peola_CoJQNilyHdEEWHt44gspqiz9JZfAXTJAyRdeg-vMjW2gLuRw_B2FIcY4OU4-nj8jVhKPXZPv7RYd271lgn6YKFePXZarprsVpZ6inw3Qh8ke9md1dz3e0mXq2PPVxiCoQ1SCMs9M68GMcs3W_O18c6QsHX7OemRLj9W7gZnwficiYq5smo6AYy9PBMYlRgrGyAcK0OjTuS"/>
        </div>
        <div class="flex flex-col justify-between py-1">
          <div>
            <h4 class="font-headline-lg text-md">Viceroy Bali</h4>
            <div class="flex items-center gap-0.5 text-secondary">
              <span class="material-symbols-outlined text-sm" data-weight="fill">star</span>
              <span class="material-symbols-outlined text-sm" data-weight="fill">star</span>
              <span class="material-symbols-outlined text-sm" data-weight="fill">star</span>
              <span class="material-symbols-outlined text-sm" data-weight="fill">star</span>
              <span class="material-symbols-outlined text-sm" data-weight="fill">star</span>
              <span class="text-sm text-text-secondary ml-1">(4.9)</span>
            </div>
          </div>
          <div class="flex justify-between items-end">
            <span class="text-sm text-text-secondary">Ubud, Bali</span>
            <span class="font-bold text-primary">Desde $480/noche</span>
          </div>
        </div>
      </div>
      <div class="flex gap-4 bg-surface p-4 rounded-lg border border-border shadow-card hover:shadow-md transition-all group">
        <div class="w-32 h-32 rounded-lg overflow-hidden shrink-0">
          <img alt="Potato Head Suites" class="w-full h-full object-cover group-hover:scale-105 transition-transform" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDgUEFScR_97ODU9c6nzQQRi7jcrB0KbZO8jrtIVl6k0aEx3lQbUCF6eiqDOVgnjf4u2ABtqGkc_wmISYmfsi77xCvKNyHqaKMTuaVLJWZLDMcIEfnq76vG2-geKFDUwfXMMEZ6NOqLFsRA8eovvSBD30oYJCNjtKbPnYEdeidV3IwlFmziSJfHvZahD2L1L5chxMHPX_O7wN3_Z-M0QoTOiOoxwyhpnQiwhTUGsbimiPp4MhUMp8VSLQSOvpaoGOklOPIueg7H_tTR"/>
        </div>
        <div class="flex flex-col justify-between py-1">
          <div>
            <h4 class="font-headline-lg text-md">Potato Head Suites</h4>
            <div class="flex items-center gap-0.5 text-secondary">
              <span class="material-symbols-outlined text-sm" data-weight="fill">star</span>
              <span class="material-symbols-outlined text-sm" data-weight="fill">star</span>
              <span class="material-symbols-outlined text-sm" data-weight="fill">star</span>
              <span class="material-symbols-outlined text-sm" data-weight="fill">star</span>
              <span class="material-symbols-outlined text-sm">star</span>
              <span class="text-sm text-text-secondary ml-1">(4.7)</span>
            </div>
          </div>
          <div class="flex justify-between items-end">
            <span class="text-sm text-text-secondary">Seminyak, Bali</span>
            <span class="font-bold text-primary">Desde $320/noche</span>
          </div>
        </div>
      </div>
    </div>
  </main>
  <%= render partial: "shared/right_panel" %>
</div>
