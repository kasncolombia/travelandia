<%= render partial: "shared/head" %>

<div class="h-screen overflow-hidden grid bg-background dark:bg-dark-bg" style="grid-template-rows: 60px 1fr; grid-template-columns: 280px 1fr 320px;">

  <%= render partial: "shared/topbar" %>
  <%= render partial: "shared/sidebar" %>

  <!-- MAIN CONTENT - EXPLORER -->
  <main class="overflow-y-auto p-6 space-y-6 bg-background" style="grid-column: 2; grid-row: 2;">
    <div class="flex flex-col md:flex-row justify-between items-end gap-4">
      <div>
        <h2 class="text-2xl font-bold text-text-primary font-poppins">Explorar destinos</h2>
        <p class="text-base text-text-secondary mt-1">Encuentra tu próxima aventura filtrando por lo que más te importa.</p>
      </div>
      <div class="flex items-center gap-2 bg-gray-100 p-1 rounded-full">
        <button class="px-4 py-2 rounded-full bg-white shadow-sm text-sm font-bold text-primary">Lista</button>
        <button class="px-4 py-2 rounded-full text-text-secondary hover:text-primary text-sm">Mapa</button>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="bg-white/70 backdrop-blur-md p-4 rounded-lg border border-border shadow-card">
        <div class="flex items-center gap-2 text-primary mb-2"><span class="text-xl">💰</span><span class="text-sm font-bold">Presupuesto</span></div>
        <select class="w-full bg-gray-50 border border-border rounded-xs text-sm p-2.5 text-text-secondary focus:ring-primary"><option>Económico (Menos de $1k)</option><option>Moderado ($1k - $3k)</option><option>Lujo ($3k+)</option></select>
      </div>
      <div class="bg-white/70 backdrop-blur-md p-4 rounded-lg border border-border shadow-card">
        <div class="flex items-center gap-2 text-primary mb-2"><span class="text-xl">🌡️</span><span class="text-sm font-bold">Clima ideal</span></div>
        <div class="flex gap-1"><button class="p-2 rounded-lg bg-primary text-white"><span class="text-xl">☀️</span></button><button class="p-2 rounded-lg bg-gray-100 hover:bg-gray-200"><span class="text-xl">❄️</span></button><button class="p-2 rounded-lg bg-gray-100 hover:bg-gray-200"><span class="text-xl">💧</span></button></div>
      </div>
      <div class="bg-white/70 backdrop-blur-md p-4 rounded-lg border border-border shadow-card">
        <div class="flex items-center gap-2 text-primary mb-2"><span class="text-xl">🥾</span><span class="text-sm font-bold">Actividad</span></div>
        <div class="flex flex-wrap gap-1"><span class="px-2 py-1 bg-accent/20 text-text-secondary rounded-full text-[10px] font-bold">AVENTURA</span><span class="px-2 py-1 bg-blue-100 text-text-secondary rounded-full text-[10px] font-bold">RELAX</span></div>
      </div>
      <div class="border-2 border-accent bg-white/70 backdrop-blur-md p-4 rounded-lg shadow-card">
        <div class="flex items-center justify-between"><div class="flex items-center gap-2 text-accent"><span class="text-xl">✨</span><span class="text-sm font-bold">Sugerencias IA</span></div><span class="px-2 py-0.5 bg-accent/20 text-text-secondary rounded text-[10px] font-bold">BETA</span></div>
        <p class="text-xs text-text-secondary italic mt-2">"Basado en tus viajes a Bali y Japón..."</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      <% [['kioto-japon','Kioto, Japón','4.9','$2,450','https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=400&q=80','Cultura','Región de Kansai'],['positano-italia','Positano, Italia','4.8','$1,890','https://images.unsplash.com/photo-1516483638261-f4dbaf036963?w=400&q=80','Relax','Costa Amalfitana'],['zermatt-suiza','Zermatt, Suiza','4.7','$3,120','https://images.unsplash.com/photo-1531366936337-7c912a4589a7?w=400&q=80','Esquí','Cantón del Valais'],['la-fortuna-costa-rica','La Fortuna, Costa Rica','4.6','$1,250','https://images.unsplash.com/photo-1518186233392-c232efbf2373?w=400&q=80','Ecoturismo','Alajuela']].each do |slug, name, rating, price, img, tag, region| %>
        <a href="/destinos/<%= slug %>" class="group bg-surface rounded-lg border border-border shadow-card hover:shadow-hover transition-all duration-300 flex flex-col overflow-hidden cursor-pointer">
          <div class="relative h-48 overflow-hidden"><img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" src="<%= img %>"/>
            <div class="absolute top-3 right-3"><span class="p-1.5 bg-white/20 backdrop-blur-sm rounded-full text-white inline-flex"><span class="text-lg">🤍</span></span></div>
            <div class="absolute bottom-3 left-3 flex gap-1"><span class="px-2 py-0.5 bg-primary text-white text-[10px] font-bold rounded-full">OFERTA</span><span class="px-2 py-0.5 bg-accent text-text-primary text-[10px] font-bold rounded-full uppercase">TOP</span></div>
          </div>
          <div class="p-4 flex-1 flex flex-col">
            <div class="flex justify-between items-start mb-1"><h3 class="text-base font-bold text-text-primary"><%= name %></h3><div class="flex items-center gap-0.5 text-accent"><span class="text-sm">★</span><span class="text-xs font-bold"><%= rating %></span></div></div>
            <p class="text-xs text-text-muted mb-2"><%= region %></p>
            <div class="flex items-center gap-1 mb-3"><span class="px-2 py-0.5 border border-border rounded text-[10px] font-bold text-text-secondary"><%= tag %></span></div>
            <div class="mt-auto flex items-end justify-between border-t border-border pt-3">
              <div><p class="text-xs text-text-muted">Desde</p><p class="text-base font-bold text-primary"><%= price %> <span class="text-xs text-text-secondary font-normal">/ pers.</span></p></div>
              <span class="p-2 bg-gray-100 text-primary rounded-lg group-hover:bg-primary group-hover:text-white transition-all inline-flex"><span class="text-lg">→</span></span>
            </div>
          </div>
        </a>
      <% end %>
    </div>
  </main>

  <%= render partial: "shared/right_panel" %>

</div>
