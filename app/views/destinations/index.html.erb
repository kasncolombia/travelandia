<%= render partial: "shared/head" %>

<div class="min-h-screen bg-background dark:bg-dark-bg flex flex-col lg:grid lg:grid-rows-[60px_1fr] lg:grid-cols-[260px_1fr_300px] xl:grid-cols-[280px_1fr_320px] lg:h-screen lg:overflow-hidden pb-16 lg:pb-0">

  <%= render partial: "shared/topbar" %>
  <%= render partial: "shared/sidebar" %>

  <!-- MAIN CONTENT - EXPLORER -->
  <main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6 bg-background dark:bg-dark-bg lg:col-start-2 lg:row-start-2">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-text-primary dark:text-dark-text font-poppins">Explorar destinos</h2>
        <p class="text-xs sm:text-sm text-text-secondary dark:text-dark-text-sec mt-0.5">Encuentra tu próxima aventura filtrando por lo que más te importa.</p>
      </div>
      <div class="flex items-center gap-1.5 bg-gray-100 dark:bg-dark-border p-1 rounded-full self-start sm:self-auto">
        <button class="px-3.5 py-1.5 rounded-full bg-white dark:bg-dark-surface shadow-sm text-xs font-bold text-primary">Lista</button>
        <button class="px-3.5 py-1.5 rounded-full text-text-secondary dark:text-dark-text-sec hover:text-primary text-xs font-medium">Mapa</button>
      </div>
    </div>

    <!-- Filters Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      <div class="bg-surface dark:bg-dark-surface p-3.5 sm:p-4 rounded-xl border border-border dark:border-dark-border shadow-card">
        <div class="flex items-center gap-2 text-primary mb-1.5"><span class="text-lg">💰</span><span class="text-xs sm:text-sm font-bold text-text-primary dark:text-dark-text">Presupuesto</span></div>
        <select class="w-full bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border rounded-lg text-xs sm:text-sm p-2 text-text-secondary dark:text-dark-text-sec outline-none focus:border-primary"><option>Económico (&lt; $1k)</option><option>Moderado ($1k - $3k)</option><option>Lujo ($3k+)</option></select>
      </div>

      <div class="bg-surface dark:bg-dark-surface p-3.5 sm:p-4 rounded-xl border border-border dark:border-dark-border shadow-card">
        <div class="flex items-center gap-2 text-primary mb-1.5"><span class="text-lg">🌡️</span><span class="text-xs sm:text-sm font-bold text-text-primary dark:text-dark-text">Clima ideal</span></div>
        <div class="flex gap-1.5"><button class="p-2 rounded-lg bg-primary text-white text-xs font-bold flex-1">☀️ Soleado</button><button class="p-2 rounded-lg bg-gray-100 dark:bg-dark-bg hover:bg-gray-200 text-xs font-medium flex-1">❄️ Frío</button><button class="p-2 rounded-lg bg-gray-100 dark:bg-dark-bg hover:bg-gray-200 text-xs font-medium flex-1">💧 Templado</button></div>
      </div>

      <div class="bg-surface dark:bg-dark-surface p-3.5 sm:p-4 rounded-xl border border-border dark:border-dark-border shadow-card">
        <div class="flex items-center gap-2 text-primary mb-1.5"><span class="text-lg">🥾</span><span class="text-xs sm:text-sm font-bold text-text-primary dark:text-dark-text">Actividad</span></div>
        <div class="flex flex-wrap gap-1.5"><span class="px-2.5 py-1 bg-accent/20 text-text-primary dark:text-dark-text rounded-full text-[10px] font-bold">AVENTURA</span><span class="px-2.5 py-1 bg-blue-100 dark:bg-blue-900/30 text-primary rounded-full text-[10px] font-bold">RELAX</span><span class="px-2.5 py-1 bg-gray-100 dark:bg-dark-bg text-text-muted rounded-full text-[10px] font-bold">+ MÁS</span></div>
      </div>

      <div class="border-2 border-accent bg-surface dark:bg-dark-surface p-3.5 sm:p-4 rounded-xl shadow-card">
        <div class="flex items-center justify-between"><div class="flex items-center gap-2 text-accent"><span class="text-lg">✨</span><span class="text-xs sm:text-sm font-bold text-text-primary dark:text-dark-text">Sugerencias IA</span></div><span class="px-2 py-0.5 bg-accent/20 text-text-primary dark:text-dark-text rounded text-[10px] font-bold">BETA</span></div>
        <p class="text-xs text-text-secondary dark:text-dark-text-sec italic mt-1.5">"Basado en tus viajes a Bali y Japón..."</p>
      </div>
    </div>

    <!-- Destination Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5">
      <% [['kioto-japon','Kioto, Japón','4.9','$2,450','https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=400&q=80','Cultura','Región de Kansai'],['positano-italia','Positano, Italia','4.8','$1,890','https://images.unsplash.com/photo-1516483638261-f4dbaf036963?w=400&q=80','Relax','Costa Amalfitana'],['zermatt-suiza','Zermatt, Suiza','4.7','$3,120','https://images.unsplash.com/photo-1531366936337-7c912a4589a7?w=400&q=80','Esquí','Cantón del Valais'],['la-fortuna-costa-rica','La Fortuna, Costa Rica','4.6','$1,250','https://images.unsplash.com/photo-1518186233392-c232efbf2373?w=400&q=80','Ecoturismo','Alajuela']].each do |slug, name, rating, price, img, tag, region| %>
        <a href="/destinos/<%= slug %>" class="group bg-surface dark:bg-dark-surface rounded-xl border border-border dark:border-dark-border shadow-card hover:shadow-hover transition-all duration-300 flex flex-col overflow-hidden cursor-pointer">
          <div class="relative h-44 sm:h-48 overflow-hidden">
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="<%= img %>" alt="<%= name %>"/>
            <div class="absolute top-3 right-3"><span class="p-1.5 bg-white/30 backdrop-blur-sm rounded-full text-white inline-flex"><span class="text-base sm:text-lg">🤍</span></span></div>
            <div class="absolute bottom-3 left-3 flex gap-1.5"><span class="px-2 py-0.5 bg-primary text-white text-[10px] font-bold rounded-full">OFERTA</span><span class="px-2 py-0.5 bg-accent text-text-primary text-[10px] font-bold rounded-full uppercase">TOP</span></div>
          </div>
          <div class="p-4 flex-1 flex flex-col">
            <div class="flex justify-between items-start mb-1"><h3 class="text-sm sm:text-base font-bold text-text-primary dark:text-dark-text"><%= name %></h3><div class="flex items-center gap-0.5 text-accent"><span class="text-xs sm:text-sm">★</span><span class="text-xs font-bold text-text-primary dark:text-dark-text"><%= rating %></span></div></div>
            <p class="text-xs text-text-muted dark:text-dark-text-sec mb-2"><%= region %></p>
            <div class="flex items-center gap-1 mb-3"><span class="px-2 py-0.5 border border-border dark:border-dark-border rounded text-[10px] font-bold text-text-secondary dark:text-dark-text-sec"><%= tag %></span></div>
            <div class="mt-auto flex items-end justify-between border-t border-border dark:border-dark-border pt-3">
              <div><p class="text-[11px] text-text-muted dark:text-dark-text-sec">Desde</p><p class="text-sm sm:text-base font-bold text-primary"><%= price %> <span class="text-xs text-text-secondary dark:text-dark-text-sec font-normal">/ pers.</span></p></div>
              <span class="p-2 bg-gray-100 dark:bg-dark-bg text-primary rounded-lg group-hover:bg-primary group-hover:text-white transition-all inline-flex"><span class="text-sm sm:text-base">→</span></span>
            </div>
          </div>
        </a>
      <% end %>
    </div>
  </main>

  <div class="hidden lg:block lg:col-start-3 lg:row-start-2">
    <%= render partial: "shared/right_panel" %>
  </div>

</div>

<!-- Floating Mobile Navigation -->
<%= render partial: "shared/bottom_nav" %>
