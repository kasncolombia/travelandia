<%= render partial: "shared/head" %>

<body class="bg-background dark:bg-dark-bg font-sans min-h-screen flex text-text-primary dark:text-dark-text">
  <main class="w-full min-h-screen flex flex-col lg:flex-row">
    <!-- Left Hero Carousel Section -->
    <section class="relative lg:w-[42%] min-h-[35vh] lg:min-h-screen overflow-hidden bg-gradient-to-br from-teal-900 via-teal-800 to-emerald-900 flex flex-col justify-between p-6 sm:p-8 lg:p-10">
      <div id="hero-slider" class="absolute inset-0 z-0">
        <div class="slide absolute inset-0 transition-opacity duration-700 opacity-100">
          <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1573843981267-be1999ff37cd?w=1200&q=80"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
        </div>
        <div class="slide absolute inset-0 transition-opacity duration-700 opacity-0">
          <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1503220317375-aaad61436b1b?w=1200&q=80"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
        </div>
      </div>

      <!-- Header Brand -->
      <div class="relative z-10">
        <a href="/" class="w-fit inline-block">
          <h1 class="text-2xl font-bold text-white flex items-center gap-2 drop-shadow-lg hover:opacity-80 transition-opacity font-poppins">
            <span class="text-xl">🌴</span> Travel<span class="text-teal-300">IA</span>
          </h1>
        </a>
      </div>

      <!-- Feature Card -->
      <div id="slide-content" class="relative z-10 space-y-4 max-w-md my-auto pt-6 lg:pt-0">
        <div class="bg-white/10 backdrop-blur-md rounded-2xl p-5 sm:p-6 border border-white/15 space-y-3 shadow-card">
          <div class="w-10 h-10 rounded-xl bg-yellow-400/20 flex items-center justify-center text-yellow-300 text-xl font-bold">✨</div>
          <h3 id="slide-title" class="text-lg font-bold text-white font-poppins">Tu asistente IA de viajes</h3>
          <p id="slide-desc" class="text-xs sm:text-sm text-white/80 leading-relaxed">TravelIA usa inteligencia avanzada para crear itinerarios personalizados en segundos.</p>
          <div class="flex items-center gap-3 pt-1">
            <div class="flex -space-x-2">
              <div class="w-7 h-7 rounded-full border-2 border-white bg-gradient-to-br from-blue-400 to-blue-600"></div>
              <div class="w-7 h-7 rounded-full border-2 border-white bg-gradient-to-br from-emerald-400 to-emerald-600"></div>
              <div class="w-7 h-7 rounded-full border-2 border-white bg-gradient-to-br from-purple-400 to-purple-600"></div>
            </div>
            <span id="slide-users" class="text-xs text-white/80 font-medium">+10k exploradores activos</span>
          </div>
        </div>

        <div class="flex items-center justify-between pt-2">
          <div class="flex gap-3">
            <div class="bg-white/10 backdrop-blur-sm rounded-lg px-3 py-1.5 border border-white/10">
              <p class="text-white text-sm font-bold">+50k</p>
              <p class="text-white/70 text-[10px]">Viajeros</p>
            </div>
            <div class="bg-white/10 backdrop-blur-sm rounded-lg px-3 py-1.5 border border-white/10">
              <p class="text-white text-sm font-bold">4.9 ★</p>
              <p class="text-white/70 text-[10px]">Rating global</p>
            </div>
          </div>

          <div class="flex items-center gap-1.5">
            <button onclick="goSlide(0)" class="slider-dot w-2 h-2 rounded-full bg-white transition-all cursor-pointer"></button>
            <button onclick="goSlide(1)" class="slider-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white/80 transition-all cursor-pointer"></button>
          </div>
        </div>
      </div>
    </section>

    <!-- Right Registration Form -->
    <section class="flex-1 bg-surface dark:bg-dark-surface flex items-center justify-center p-6 sm:p-10 lg:p-12">
      <div class="w-full max-w-[420px] space-y-6">
        <!-- Logo Mobile -->
        <div class="lg:hidden flex items-center gap-2 mb-2">
          <a href="/" class="flex items-center gap-2">
            <span class="text-primary text-2xl">🌴</span>
            <h1 class="text-xl font-bold text-text-primary dark:text-dark-text font-poppins">Travel<span class="text-primary">IA</span></h1>
          </a>
        </div>

        <!-- Title -->
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-text-primary dark:text-dark-text font-poppins">Crear tu cuenta</h2>
          <p class="text-xs sm:text-sm text-text-secondary dark:text-dark-text-sec mt-1">Únete a nuestra comunidad de viajeros inteligentes.</p>
        </div>

        <!-- Alerts -->
        <% if flash[:alert] %>
          <div class="p-3 bg-rose-500/10 border border-rose-500/30 text-rose-600 dark:text-rose-400 text-xs font-semibold rounded-xl flex items-center gap-2">
            <span class="material-symbols-outlined text-base">error</span>
            <%= flash[:alert] %>
          </div>
        <% end %>

        <!-- Registration Form -->
        <form action="/registro" method="post" class="space-y-4">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

          <div>
            <label class="text-xs font-semibold text-text-muted dark:text-dark-text-sec ml-1">Nombre o Usuario</label>
            <div class="relative mt-1">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-text-muted dark:text-dark-text-sec text-base material-symbols-outlined">person</span>
              <input name="username" required class="w-full h-11 pl-10 pr-4 bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border rounded-xl focus:ring-2 focus:ring-primary text-xs sm:text-sm outline-none text-text-primary dark:text-dark-text placeholder:text-text-muted" placeholder="Alex Johnson" type="text"/>
            </div>
          </div>

          <div>
            <label class="text-xs font-semibold text-text-muted dark:text-dark-text-sec ml-1">Correo electrónico</label>
            <div class="relative mt-1">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-text-muted dark:text-dark-text-sec text-base material-symbols-outlined">mail</span>
              <input name="email" required class="w-full h-11 pl-10 pr-4 bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border rounded-xl focus:ring-2 focus:ring-primary text-xs sm:text-sm outline-none text-text-primary dark:text-dark-text placeholder:text-text-muted" placeholder="alex@ejemplo.com" type="email"/>
            </div>
          </div>

          <div>
            <label class="text-xs font-semibold text-text-muted dark:text-dark-text-sec ml-1">Contraseña</label>
            <div class="relative mt-1">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-text-muted dark:text-dark-text-sec text-base material-symbols-outlined">lock</span>
              <input name="password" required class="w-full h-11 pl-10 pr-4 bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border rounded-xl focus:ring-2 focus:ring-primary text-xs sm:text-sm outline-none text-text-primary dark:text-dark-text placeholder:text-text-muted" placeholder="Crea una contraseña segura" type="password"/>
            </div>
          </div>

          <div class="pt-2">
            <button type="submit" class="w-full bg-primary text-white font-bold py-3 rounded-xl hover:bg-primary-dark transition-all shadow-md text-xs sm:text-sm cursor-pointer flex items-center justify-center gap-2">
              Crear cuenta gratuita
              <span class="material-symbols-outlined text-base">arrow_forward</span>
            </button>
          </div>
        </form>

        <!-- Guest link option -->
        <div class="text-center pt-2">
          <a href="/login/guest" class="text-xs font-semibold text-teal-700 dark:text-teal-400 hover:underline inline-flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">visibility</span>
            O probar la plataforma como invitado
          </a>
        </div>

        <p class="text-center text-xs text-text-secondary dark:text-dark-text-sec pt-2">¿Ya tienes una cuenta? <a class="text-primary font-bold hover:underline" href="/login">Inicia sesión</a></p>
      </div>
    </section>
  </main>

  <script>
    const slides = [
      { title: 'Tu asistente IA de viajes', desc: 'TravelIA usa inteligencia avanzada para crear itinerarios personalizados en segundos.', users: '+10k exploradores activos' },
      { title: 'Descubre destinos increíbles', desc: 'Recomendaciones curadas por IA basadas en tus gustos, presupuesto y temporada ideal.', users: '+8k destinos verificados' }
    ];
    let current = 0;
    setInterval(() => {
      document.querySelectorAll('.slide')[current].classList.remove('opacity-100');
      document.querySelectorAll('.slide')[current].classList.add('opacity-0');
      document.querySelectorAll('.slider-dot')[current].classList.remove('bg-white');
      document.querySelectorAll('.slider-dot')[current].classList.add('bg-white/50');
      current = (current + 1) % slides.length;
      document.querySelectorAll('.slide')[current].classList.remove('opacity-0');
      document.querySelectorAll('.slide')[current].classList.add('opacity-100');
      document.querySelectorAll('.slider-dot')[current].classList.remove('bg-white/50');
      document.querySelectorAll('.slider-dot')[current].classList.add('bg-white');
      document.getElementById('slide-title').textContent = slides[current].title;
      document.getElementById('slide-desc').textContent = slides[current].desc;
      document.getElementById('slide-users').textContent = slides[current].users;
    }, 5000);
  </script>
</body>
