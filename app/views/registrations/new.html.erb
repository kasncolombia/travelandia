<body class="bg-background font-sans text-gray-900 antialiased overflow-x-hidden">
  <main class="min-h-screen flex flex-col lg:flex-row">
    <section class="relative lg:w-[40%] min-h-[35vh] lg:min-h-screen overflow-hidden bg-gradient-to-br from-teal-900 via-teal-800 to-emerald-900">
      <div id="hero-slider" class="absolute inset-0">
        <div class="slide absolute inset-0 transition-opacity duration-700 opacity-0">
          <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1573843981267-be1999ff37cd?w=1200&q=80"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
        </div>
        <div class="slide absolute inset-0 transition-opacity duration-700 opacity-0">
          <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1503220317375-aaad61436b1b?w=1200&q=80"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
        </div>
        <div class="slide absolute inset-0 transition-opacity duration-700 opacity-0">
          <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?w=1200&q=80"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
        </div>
      </div>
      <div class="relative h-full flex flex-col justify-between p-8 lg:p-10 z-10">
        <a href="/" class="w-fit">
          <h1 class="text-2xl font-bold text-white flex items-center gap-2 drop-shadow-lg hover:opacity-80 transition-opacity">
            <span class="text-xl">🌴</span> Travel<span class="text-teal-300">IA</span>
          </h1>
        </a>
        <div id="slide-content" class="space-y-6 max-w-sm">
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/10 space-y-4">
            <div class="w-12 h-12 rounded-full bg-yellow-400/20 flex items-center justify-center">
              <span id="slide-icon" class="text-2xl">✨</span>
            </div>
            <h3 id="slide-title" class="text-xl font-bold text-white font-poppins">Tu asistente IA de viajes</h3>
            <p id="slide-desc" class="text-sm text-white/80">TravelIA usa inteligencia avanzada para crear itinerarios personalizados en segundos.</p>
            <div class="flex items-center gap-3 pt-2">
              <div class="flex -space-x-2">
                <div class="w-8 h-8 rounded-full border-2 border-white bg-gradient-to-br from-blue-400 to-blue-600"></div>
                <div class="w-8 h-8 rounded-full border-2 border-white bg-gradient-to-br from-green-400 to-green-600"></div>
                <div class="w-8 h-8 rounded-full border-2 border-white bg-gradient-to-br from-purple-400 to-purple-600"></div>
              </div>
              <span id="slide-users" class="text-xs text-white/70">+10k exploradores</span>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="bg-white/10 backdrop-blur-sm rounded-xl px-4 py-3 border border-white/10">
              <p class="text-white text-lg font-bold">+50k</p>
              <p class="text-white/60 text-xs">Viajeros</p>
            </div>
            <div class="bg-white/10 backdrop-blur-sm rounded-xl px-4 py-3 border border-white/10">
              <p class="text-white text-lg font-bold">4.9</p>
              <p class="text-white/60 text-xs">Valoración</p>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="goSlide(0)" class="slider-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white/80 transition-all cursor-pointer"></button>
          <button onclick="goSlide(1)" class="slider-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white/80 transition-all cursor-pointer"></button>
          <button onclick="goSlide(2)" class="slider-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white/80 transition-all cursor-pointer"></button>
        </div>
      </div>
    </section>
    <section class="flex-1 bg-surface flex items-center justify-center px-6 py-8 lg:py-0">
      <div class="w-full max-w-[420px] space-y-6">
        <div class="lg:hidden flex items-center gap-2 mb-2">
          <a href="/" class="flex items-center gap-2">
            <span class="text-teal-600 text-xl">🌴</span>
            <h1 class="text-xl font-bold text-gray-900">Travel<span class="text-primary">IA</span></h1>
          </a>
        </div>
        <div>
          <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 font-poppins">Crear tu cuenta</h2>
          <p class="text-gray-500 mt-1">Únete a nuestra comunidad de viajeros inteligentes.</p>
        </div>
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center text-sm font-bold">1</div>
            <span class="text-sm font-semibold text-gray-700">Datos</span>
          </div>
          <div class="h-px flex-1 bg-gray-200"></div>
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-400 flex items-center justify-center text-sm font-bold">2</div>
            <span class="text-sm text-gray-400">Preferencias</span>
          </div>
          <div class="h-px flex-1 bg-gray-200"></div>
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-400 flex items-center justify-center text-sm font-bold">3</div>
            <span class="text-sm text-gray-400">¡Listo!</span>
          </div>
        </div>
        <form class="space-y-4">
          <div>
            <label class="text-sm font-medium text-gray-600 ml-1">Nombre completo</label>
            <div class="relative mt-1">
              <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400 text-lg material-symbols-outlined">person</span>
              <input class="w-full h-12 pl-11 pr-4 bg-gray-100 border-none rounded-xl focus:ring-2 focus:ring-primary text-base outline-none text-gray-800 placeholder:text-gray-400" placeholder="Alex Johnson" type="text"/>
            </div>
          </div>
          <div>
            <label class="text-sm font-medium text-gray-600 ml-1">Correo electrónico</label>
            <div class="relative mt-1">
              <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400 text-lg material-symbols-outlined">mail</span>
              <input class="w-full h-12 pl-11 pr-4 bg-gray-100 border-none rounded-xl focus:ring-2 focus:ring-primary text-base outline-none text-gray-800 placeholder:text-gray-400" placeholder="alex@travelia.com" type="email"/>
            </div>
          </div>
          <div>
            <label class="text-sm font-medium text-gray-600 ml-1">Contraseña</label>
            <div class="relative mt-1">
              <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400 text-lg material-symbols-outlined">lock</span>
              <input class="w-full h-12 pl-11 pr-4 bg-gray-100 border-none rounded-xl focus:ring-2 focus:ring-primary text-base outline-none text-gray-800 placeholder:text-gray-400" placeholder="Crea una contraseña segura" type="password"/>
            </div>
          </div>
          <div class="pt-2">
            <button class="w-full bg-primary text-white font-semibold py-3.5 rounded-xl hover:bg-teal-700 transition-all shadow-md text-base cursor-pointer flex items-center justify-center gap-2" type="submit">
              Crear cuenta gratuita
              <span class="material-symbols-outlined text-lg">arrow_forward</span>
            </button>
          </div>
        </form>
        <div class="relative flex items-center">
          <div class="flex-grow border-t border-gray-200"></div>
          <span class="flex-shrink mx-4 text-sm text-gray-400">O regístrate con</span>
          <div class="flex-grow border-t border-gray-200"></div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <button class="flex items-center justify-center gap-2.5 bg-white border border-gray-200 py-3 rounded-xl hover:bg-gray-50 hover:border-gray-300 transition-all text-sm font-medium text-gray-700 cursor-pointer">
            <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
            Google
          </button>
          <button class="flex items-center justify-center gap-2.5 bg-white border border-gray-200 py-3 rounded-xl hover:bg-gray-50 hover:border-gray-300 transition-all text-sm font-medium text-gray-700 cursor-pointer">
            <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C4.1 16.5 4.3 10.5 7.5 10.2c1.3.1 2 .8 2.8.8.8 0 1.9-.9 3.5-.8 1.4.1 2.5.6 3.2 1.6-2.9 1.7-2.4 5.6.5 6.8-.6 1.3-1.3 2.6-2.4 3.7zM12.03 9.4c-.1 0-.1 0 0 0 .1-2.2 1.8-4 4-4 .1 2.3-1.9 4.3-4 4z"/></svg>
            Apple
          </button>
        </div>
        <p class="text-center text-sm text-gray-500">¿Ya tienes cuenta? <a class="text-primary font-bold hover:underline" href="/login">Inicia sesión</a></p>
      </div>
    </section>
  </main>
</body>
<script>
  const slides = [
    {
      img: 0,
      icon: '✨', title: 'Tu asistente IA de viajes',
      desc: 'TravelIA usa inteligencia avanzada para crear itinerarios personalizados en segundos.',
      users: '+10k exploradores'
    },
    {
      img: 1,
      icon: '🌍', title: 'Descubre el mundo',
      desc: 'Recomendaciones curadas por IA basadas en tus gustos, presupuesto y temporada ideal.',
      users: '+8k destinos'
    },
    {
      img: 2,
      icon: '🎯', title: 'Itinerarios perfectos',
      desc: 'Desde escapadas de fin de semana hasta aventuras de un mes, todo optimizado al detalle.',
      users: '+15k planes creados'
    }
  ];
  let current = 0;
  const interval = setInterval(() => { goSlide((current + 1) % slides.length) }, 5000);
  function goSlide(i) {
    document.querySelectorAll('.slide')[current].classList.remove('opacity-100');
    document.querySelectorAll('.slide')[current].classList.add('opacity-0');
    document.querySelectorAll('.slider-dot')[current].classList.remove('bg-white');
    document.querySelectorAll('.slider-dot')[current].classList.add('bg-white/50');
    current = i;
    document.querySelectorAll('.slide')[current].classList.remove('opacity-0');
    document.querySelectorAll('.slide')[current].classList.add('opacity-100');
    document.querySelectorAll('.slider-dot')[current].classList.remove('bg-white/50');
    document.querySelectorAll('.slider-dot')[current].classList.add('bg-white');
    document.getElementById('slide-icon').textContent = slides[current].icon;
    document.getElementById('slide-title').textContent = slides[current].title;
    document.getElementById('slide-desc').textContent = slides[current].desc;
    document.getElementById('slide-users').textContent = slides[current].users;
  }
  document.querySelectorAll('.slide')[0].classList.add('opacity-100');
  document.querySelectorAll('.slider-dot')[0].classList.add('bg-white');
</script>
