<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @hotel[:name] %> en <%= @hotel[:destination] %>, <%= @hotel[:country] %> - Reserva | TravelIA</title>
  <meta name="description" content="<%= @hotel[:meta_description] %>">
  <link rel="canonical" href="http://localhost:3000/hoteles/<%= @hotel[:slug] %>">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Google Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

<body class="h-full bg-background dark:bg-dark-bg text-text-primary dark:text-dark-text antialiased font-sans">
<div class="min-h-screen bg-background dark:bg-dark-bg flex flex-col lg:grid lg:grid-rows-[60px_1fr] lg:grid-cols-[260px_1fr_300px] xl:grid-cols-[280px_1fr_320px] lg:h-screen lg:overflow-hidden pb-16 lg:pb-0">

  <%= render partial: "shared/topbar" %>
  <%= render partial: "shared/sidebar" %>

  <!-- MAIN HOTEL DETAIL -->
  <main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6 bg-background dark:bg-dark-bg lg:col-start-2 lg:row-start-2">
    <!-- Breadcrumb Nav -->
    <nav class="flex items-center gap-2 text-xs text-text-muted dark:text-dark-text-sec">
      <a href="/" class="hover:text-primary transition-colors">Inicio</a>
      <span>/</span>
      <a href="/hoteles" class="hover:text-primary transition-colors">Hoteles</a>
      <span>/</span>
      <span class="text-text-primary dark:text-dark-text font-semibold truncate"><%= @hotel[:name] %></span>
    </nav>

    <!-- Header Section -->
    <header class="space-y-3">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2.5 py-0.5 bg-primary-light dark:bg-primary/20 text-primary text-xs font-bold rounded-full"><%= @hotel[:tag] %></span>
            <div class="flex items-center text-yellow-400 text-xs">
              <% (1..@hotel[:stars]).each do %>★<% end %>
            </div>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-text-primary dark:text-dark-text font-poppins"><%= @hotel[:name] %></h1>
          <p class="text-xs sm:text-sm text-text-secondary dark:text-dark-text-sec flex items-center gap-1.5 mt-1">
            <span class="material-symbols-outlined text-primary text-base">location_on</span>
            <%= @hotel[:address] %>
          </p>
        </div>

        <div class="flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-end border-t sm:border-t-0 border-border dark:border-dark-border pt-3 sm:pt-0">
          <div class="text-left sm:text-right">
            <span class="text-[11px] text-text-muted dark:text-dark-text-sec">Precio por noche</span>
            <p class="text-xl sm:text-2xl font-bold text-primary"><%= @hotel[:currency] %><%= @hotel[:price] %> <span class="text-xs font-normal text-text-secondary">USD</span></p>
          </div>
          <button onclick="openBookingModal()" class="px-5 py-2.5 bg-primary hover:bg-primary-dark text-white font-bold text-xs sm:text-sm rounded-xl shadow-md transition-all cursor-pointer">
            Reservar Ahora
          </button>
        </div>
      </div>
    </header>

    <!-- Photo Gallery Grid -->
    <section id="hotel-gallery-section" class="grid grid-cols-1 sm:grid-cols-3 gap-3 rounded-2xl overflow-hidden shadow-card">
      <div class="sm:col-span-2 h-64 sm:h-80 overflow-hidden relative group">
        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="<%= @hotel[:img] %>" alt="<%= @hotel[:name] %> foto principal"/>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-1 gap-3 h-full">
        <% (@hotel[:gallery] || []).drop(1).first(2).each_with_index do |img_url, idx| %>
          <div class="h-32 sm:h-[154px] overflow-hidden rounded-xl relative group">
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="<%= img_url %>" alt="<%= @hotel[:name] %> galería <%= idx + 1 %>"/>
          </div>
        <% end %>
      </div>
    </section>

    <!-- Content Columns -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 space-y-6">
        <!-- Overview & Description -->
        <section class="bg-surface dark:bg-dark-surface p-5 sm:p-6 rounded-2xl border border-border dark:border-dark-border shadow-card space-y-4">
          <h2 class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text font-poppins flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">article</span>
            Acerca del Hotel
          </h2>
          <p class="text-xs sm:text-sm text-text-secondary dark:text-dark-text-sec leading-relaxed">
            <%= @hotel[:description] %>
          </p>

          <div class="pt-3 border-t border-border dark:border-dark-border grid grid-cols-2 sm:grid-cols-3 gap-4 text-xs">
            <div class="space-y-1">
              <span class="text-text-muted dark:text-dark-text-sec font-medium">Valoración</span>
              <p class="font-bold text-text-primary dark:text-dark-text flex items-center gap-1">
                <span class="text-yellow-500">★</span> <%= @hotel[:rating] %> / 5.0 (<%= @hotel[:reviews_count] || 120 %> opiniones)
              </p>
            </div>
            <div class="space-y-1">
              <span class="text-text-muted dark:text-dark-text-sec font-medium">Check-in / Check-out</span>
              <p class="font-bold text-text-primary dark:text-dark-text">15:00 PM / 12:00 PM</p>
            </div>
            <div class="space-y-1">
              <span class="text-text-muted dark:text-dark-text-sec font-medium">Ubicación</span>
              <p class="font-bold text-text-primary dark:text-dark-text truncate"><%= @hotel[:destination] %>, <%= @hotel[:country] %></p>
            </div>
          </div>
        </section>

        <!-- Amenities Grid -->
        <section class="bg-surface dark:bg-dark-surface p-5 sm:p-6 rounded-2xl border border-border dark:border-dark-border shadow-card space-y-4">
          <h2 class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text font-poppins flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">wifi</span>
            Servicios y Comodidades
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            <% (@hotel[:amenities] || []).each do |amenity| %>
              <div class="p-3 bg-gray-50 dark:bg-dark-bg rounded-xl border border-border dark:border-dark-border flex items-center gap-2.5 text-xs font-semibold text-text-primary dark:text-dark-text">
                <span class="material-symbols-outlined text-primary text-base">check_circle</span>
                <span><%= amenity %></span>
              </div>
            <% end %>
          </div>
        </section>

        <!-- Map & Location Preview -->
        <section class="bg-surface dark:bg-dark-surface p-5 sm:p-6 rounded-2xl border border-border dark:border-dark-border shadow-card space-y-4">
          <h2 class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text font-poppins flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">map</span>
            Ubicación Interactiva
          </h2>
          <p class="text-xs text-text-secondary dark:text-dark-text-sec"><%= @hotel[:address] %></p>
          <div class="h-48 sm:h-56 rounded-xl bg-primary/10 border border-border dark:border-dark-border relative overflow-hidden flex items-center justify-center">
            <svg class="absolute inset-0 w-full h-full opacity-40" viewBox="0 0 100 100">
              <path d="M10 50 Q 30 10, 50 50 T 90 50" stroke="#0D9488" stroke-width="2" fill="none" stroke-dasharray="4"/>
              <circle cx="50" cy="50" r="5" fill="#0D9488"/>
            </svg>
            <div class="relative bg-surface dark:bg-dark-surface px-4 py-2 rounded-xl shadow-md border border-border text-center">
              <span class="material-symbols-outlined text-primary text-xl">location_on</span>
              <p class="text-xs font-bold text-text-primary dark:text-dark-text"><%= @hotel[:name] %></p>
              <p class="text-[10px] text-text-muted"><%= @hotel[:destination] %></p>
            </div>
          </div>
        </section>
      </div>

      <!-- Sidebar Column: Reservation Box & Related -->
      <aside class="space-y-6">
        <div class="bg-surface dark:bg-dark-surface p-5 rounded-2xl border border-border dark:border-dark-border shadow-card space-y-4 sticky top-20">
          <h3 class="text-base font-bold text-text-primary dark:text-dark-text font-poppins">Reserva tu Estadía</h3>
          <div class="space-y-3">
            <div>
              <label class="text-[10px] uppercase font-bold text-text-muted">Fechas</label>
              <div class="grid grid-cols-2 gap-2 mt-1">
                <input class="p-2 bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border rounded-lg text-xs" type="date"/>
                <input class="p-2 bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border rounded-lg text-xs" type="date"/>
              </div>
            </div>
            <div>
              <label class="text-[10px] uppercase font-bold text-text-muted">Huéspedes</label>
              <select class="w-full mt-1 p-2 bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border rounded-lg text-xs">
                <option>2 Adultos, 1 Habitación</option>
                <option>1 Adulto, 1 Habitación</option>
                <option>2 Adultos + 2 Niños</option>
              </select>
            </div>
            <div class="p-3 bg-primary-light/40 dark:bg-primary/20 rounded-xl space-y-1">
              <div class="flex justify-between text-xs">
                <span class="text-text-secondary">Precio estimado (3 noches):</span>
                <span class="font-bold text-text-primary"><%= @hotel[:currency] %><%= @hotel[:price] * 3 %></span>
              </div>
              <div class="flex justify-between text-[11px] text-text-muted">
                <span>Impuestos e inclusión:</span>
                <span>Incluidos</span>
              </div>
            </div>
            <button onclick="openBookingModal()" class="w-full py-3 bg-primary hover:bg-primary-dark text-white font-bold text-xs sm:text-sm rounded-xl shadow-md transition-all cursor-pointer text-center block">
              Confirmar Disponibilidad
            </button>
          </div>
        </div>

        <!-- Related Hotels -->
        <div class="bg-surface dark:bg-dark-surface p-5 rounded-2xl border border-border dark:border-dark-border shadow-card space-y-4">
          <h3 class="text-sm font-bold text-text-primary dark:text-dark-text font-poppins">Hoteles Similares</h3>
          <div class="space-y-3">
            <% (@related_hotels || []).each do |rel| %>
              <a href="/hoteles/<%= rel[:slug] %>" class="flex items-center gap-3 group cursor-pointer border-b border-border/50 pb-2.5 last:border-0 last:pb-0">
                <img class="w-14 h-14 rounded-lg object-cover group-hover:scale-105 transition-transform" src="<%= rel[:img] %>" alt="<%= rel[:name] %>"/>
                <div class="min-w-0 flex-1">
                  <h4 class="text-xs font-bold text-text-primary dark:text-dark-text group-hover:text-primary transition-colors truncate"><%= rel[:name] %></h4>
                  <p class="text-[11px] text-text-muted"><%= rel[:destination] %> • ★ <%= rel[:rating] %></p>
                  <span class="text-xs font-bold text-primary"><%= rel[:currency] %><%= rel[:price] %>/noche</span>
                </div>
              </a>
            <% end %>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <div class="hidden lg:block lg:col-start-3 lg:row-start-2">
    <%= render partial: "shared/right_panel" %>
  </div>

</div>

<!-- Booking Modal -->
<div id="hotel-detail-modal" class="fixed inset-0 bg-black/60 z-50 hidden backdrop-blur-xs flex items-center justify-center p-4">
  <div class="bg-surface dark:bg-dark-surface border border-border dark:border-dark-border rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
    <div class="flex justify-between items-center border-b border-border dark:border-dark-border pb-3">
      <h3 class="font-bold text-base text-text-primary dark:text-dark-text">Reservar en <%= @hotel[:name] %></h3>
      <button onclick="closeBookingModal()" class="text-text-muted hover:text-text-primary text-lg cursor-pointer">✕</button>
    </div>
    <div class="space-y-3 text-xs">
      <p class="text-text-secondary dark:text-dark-text-sec">Confirma tus datos para proceder con la reserva en <strong><%= @hotel[:destination] %></strong>:</p>
      <div class="grid grid-cols-2 gap-2">
        <div>
          <label class="text-[10px] uppercase font-bold text-text-muted">Llegada</label>
          <input class="w-full mt-1 p-2 bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border rounded-lg text-xs" type="date"/>
        </div>
        <div>
          <label class="text-[10px] uppercase font-bold text-text-muted">Salida</label>
          <input class="w-full mt-1 p-2 bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border rounded-lg text-xs" type="date"/>
        </div>
      </div>
    </div>
    <div class="flex gap-2 pt-2">
      <button onclick="closeBookingModal()" class="flex-1 py-2.5 border border-border rounded-xl text-xs font-semibold text-text-secondary cursor-pointer">Cancelar</button>
      <button onclick="alert('¡Reserva enviada exitosamente!'); closeBookingModal();" class="flex-1 py-2.5 bg-primary text-white font-bold text-xs rounded-xl hover:bg-primary-dark cursor-pointer shadow-md">Confirmar Reserva</button>
    </div>
  </div>
</div>

<!-- Floating Mobile Navigation -->
<%= render partial: "shared/bottom_nav" %>

<script>
  function openBookingModal() {
    document.getElementById('hotel-detail-modal').classList.remove('hidden');
  }
  function closeBookingModal() {
    document.getElementById('hotel-detail-modal').classList.add('hidden');
  }
</script>

</body>
</html>
