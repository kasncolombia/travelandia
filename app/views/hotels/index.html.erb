<%= render partial: "shared/head" %>

<div class="min-h-screen bg-background dark:bg-dark-bg flex flex-col lg:grid lg:grid-rows-[60px_1fr] lg:grid-cols-[260px_1fr_300px] xl:grid-cols-[280px_1fr_320px] lg:h-screen lg:overflow-hidden pb-16 lg:pb-0">

  <%= render partial: "shared/topbar" %>
  <%= render partial: "shared/sidebar" %>

  <!-- MAIN CONTENT - HOTELS INDEX -->
  <main class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-6 bg-background dark:bg-dark-bg lg:col-start-2 lg:row-start-2">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
      <div>
        <h1 class="text-xl sm:text-2xl font-bold text-text-primary dark:text-dark-text font-poppins">Explorar hoteles</h1>
        <p class="text-xs sm:text-sm text-text-secondary dark:text-dark-text-sec mt-0.5"><%= @hotels.length %> hoteles seleccionados para tu próxima estadía.</p>
      </div>

      <div class="relative w-full sm:w-72">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-text-muted dark:text-dark-text-sec text-base">search</span>
        <input class="w-full pl-9 pr-4 py-2 bg-surface dark:bg-dark-surface border border-border dark:border-dark-border rounded-xl text-xs sm:text-sm outline-none focus:ring-2 focus:ring-primary text-text-primary dark:text-dark-text placeholder:text-text-muted" placeholder="Buscar hoteles..." type="text"/>
      </div>
    </div>

    <!-- Filters Bar -->
    <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 bg-surface dark:bg-dark-surface rounded-xl border border-border dark:border-dark-border p-3 sm:p-4 shadow-card">
      <div class="flex items-center gap-2 flex-1 min-w-[140px]">
        <span class="material-symbols-outlined text-text-muted dark:text-dark-text-sec text-base">location_on</span>
        <select class="w-full bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border rounded-lg text-xs sm:text-sm px-2.5 py-1.5 text-text-secondary dark:text-dark-text-sec outline-none">
          <option>Todos los destinos</option>
          <% @destinations.each do |d| %>
            <option><%= d %></option>
          <% end %>
        </select>
      </div>

      <div class="hidden sm:block w-px h-6 bg-border dark:bg-dark-border"></div>

      <div class="flex items-center gap-2 flex-1 min-w-[140px]">
        <span class="material-symbols-outlined text-text-muted dark:text-dark-text-sec text-base">star</span>
        <select class="w-full bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border rounded-lg text-xs sm:text-sm px-2.5 py-1.5 text-text-secondary dark:text-dark-text-sec outline-none">
          <option>Cualquier categoría</option>
          <% @star_options.each do |s| %>
            <option><%= s %> estrellas</option>
          <% end %>
        </select>
      </div>

      <div class="hidden sm:block w-px h-6 bg-border dark:bg-dark-border"></div>

      <div class="flex items-center gap-2 flex-1 min-w-[140px]">
        <span class="material-symbols-outlined text-text-muted dark:text-dark-text-sec text-base">payments</span>
        <select class="w-full bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border rounded-lg text-xs sm:text-sm px-2.5 py-1.5 text-text-secondary dark:text-dark-text-sec outline-none">
          <option>Cualquier precio</option>
          <% @price_ranges.each do |r| %>
            <option><%= r %></option>
          <% end %>
        </select>
      </div>

      <div class="flex items-center gap-1.5 ml-auto shrink-0">
        <button class="p-2 rounded-lg bg-primary-light dark:bg-primary/20 text-primary">
          <span class="material-symbols-outlined text-base">grid_view</span>
        </button>
        <button class="p-2 rounded-lg bg-gray-100 dark:bg-dark-bg text-text-muted dark:text-dark-text-sec hover:bg-gray-200 transition-colors">
          <span class="material-symbols-outlined text-base">view_list</span>
        </button>
      </div>
    </div>

    <!-- Hotel Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
      <% @hotels.each do |hotel| %>
        <div class="bg-surface dark:bg-dark-surface rounded-xl border border-border dark:border-dark-border overflow-hidden hover:shadow-hover transition-all duration-200 group cursor-pointer flex flex-col">
          <div class="relative h-44 sm:h-48 overflow-hidden">
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="<%= hotel[:img] %>" alt="<%= hotel[:name] %>"/>
            <div class="absolute top-3 left-3">
              <span class="bg-white/90 backdrop-blur-sm text-[10px] sm:text-xs font-bold px-2.5 py-0.5 rounded-full text-text-primary"><%= hotel[:tag] %></span>
            </div>
            <div class="absolute top-3 right-3">
              <button class="p-1.5 bg-white/30 backdrop-blur-sm rounded-full text-white hover:bg-white/50 transition-colors">
                <span class="material-symbols-outlined text-sm">favorite</span>
              </button>
            </div>
            <div class="absolute bottom-3 left-3 flex items-center gap-0.5 bg-black/50 backdrop-blur-sm px-2 py-0.5 rounded-lg">
              <% (1..hotel[:stars]).each do %>
                <span class="text-yellow-400 text-xs">★</span>
              <% end %>
            </div>
          </div>

          <div class="p-4 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between mb-1 gap-2">
                <h3 class="font-bold text-text-primary dark:text-dark-text text-xs sm:text-sm group-hover:text-primary transition-colors truncate"><%= hotel[:name] %></h3>
                <div class="flex items-center gap-0.5 shrink-0">
                  <span class="text-yellow-500 text-xs">★</span>
                  <span class="text-xs font-bold text-text-primary dark:text-dark-text"><%= hotel[:rating] %></span>
                </div>
              </div>
              <p class="text-xs text-text-muted dark:text-dark-text-sec mb-2 flex items-center gap-1">
                <span class="material-symbols-outlined text-xs">location_on</span>
                <%= hotel[:destination] %>, <%= hotel[:country] %>
              </p>
              <p class="text-xs text-text-secondary dark:text-dark-text-sec line-clamp-2 mb-3"><%= hotel[:description] %></p>

              <div class="flex flex-wrap gap-1 mb-3">
                <% hotel[:amenities].first(3).each do |a| %>
                  <span class="text-[10px] bg-gray-100 dark:bg-dark-bg text-text-muted dark:text-dark-text-sec px-2 py-0.5 rounded-md border border-border dark:border-dark-border"><%= a %></span>
                <% end %>
                <% if hotel[:amenities].length > 3 %>
                  <span class="text-[10px] bg-gray-100 dark:bg-dark-bg text-text-muted dark:text-dark-text-sec px-2 py-0.5 rounded-md border border-border dark:border-dark-border">+<%= hotel[:amenities].length - 3 %></span>
                <% end %>
              </div>
            </div>

            <div class="flex items-center justify-between pt-3 border-t border-border dark:border-dark-border mt-auto">
              <div>
                <span class="text-[11px] text-text-muted dark:text-dark-text-sec">Desde</span>
                <p class="text-sm sm:text-base font-bold text-primary"><%= hotel[:currency] %><%= hotel[:price] %> <span class="text-xs text-text-secondary dark:text-dark-text-sec font-normal">/ noche</span></p>
              </div>
              <button class="text-xs font-bold text-primary bg-primary-light dark:bg-primary/20 px-3.5 py-1.5 rounded-lg hover:bg-primary hover:text-white transition-all">Reservar</button>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </main>

  <div class="hidden lg:block lg:col-start-3 lg:row-start-2">
    <%= render partial: "shared/right_panel" %>
  </div>

</div>

<!-- Floating Mobile Navigation -->
<%= render partial: "shared/bottom_nav" %>
