<%= render partial: "shared/head" %>

<div class="h-screen overflow-hidden grid bg-background dark:bg-dark-bg" style="grid-template-rows: 60px 1fr; grid-template-columns: 280px 1fr 320px;">

  <%= render partial: "shared/topbar" %>
  <%= render partial: "shared/sidebar" %>

  <!-- PLANNER WORKSPACE -->
  <div class="flex overflow-hidden" style="grid-column: 2; grid-row: 2;">
    <section class="w-1/3 border-r border-border dark:border-dark-border overflow-y-auto p-6 bg-background">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-lg bg-accent/20 flex items-center justify-center"><span class="text-xl">🤖</span></div>
        <h2 class="text-lg font-bold text-text-primary font-poppins">Configurar Viaje</h2>
      </div>
      <div class="space-y-6">
        <div><label class="text-sm font-semibold text-text-secondary">Destino principal</label><div class="relative mt-1.5"><span class="absolute left-3 top-3 text-primary text-lg">📍</span><input class="w-full pl-10 pr-4 py-3 bg-surface border border-border dark:border-dark-border rounded-xs text-sm focus:ring-2 focus:ring-primary" type="text" value="Tokio, Japón"/></div></div>
        <div><label class="text-sm font-semibold text-text-secondary">Fechas del viaje</label><div class="flex gap-3 mt-1.5"><div class="flex-1 bg-surface border border-border dark:border-dark-border p-3 rounded-xs"><p class="text-[10px] text-text-muted uppercase font-bold">Desde</p><p class="text-sm font-semibold">15 Oct, 2024</p></div><div class="flex-1 bg-surface border border-border dark:border-dark-border p-3 rounded-xs"><p class="text-[10px] text-text-muted uppercase font-bold">Hasta</p><p class="text-sm font-semibold">22 Oct, 2024</p></div></div></div>
        <div><label class="text-sm font-semibold text-text-secondary">Presupuesto estimado</label><div class="flex items-center gap-3 mt-1.5"><input class="flex-1 accent-primary h-1.5 rounded-full bg-gray-200" type="range"/><span class="text-sm font-bold text-primary">$5.5M</span></div></div>
        <div><label class="text-sm font-semibold text-text-secondary mb-2 block">Intereses destacados</label><div class="flex flex-wrap gap-1.5">
          <span class="px-3 py-1 bg-primary text-white rounded-full text-xs flex items-center gap-1">Gastronomía ✕</span>
          <span class="px-3 py-1 bg-primary text-white rounded-full text-xs flex items-center gap-1">Fotografía ✕</span>
          <span class="px-3 py-1 bg-primary text-white rounded-full text-xs flex items-center gap-1">Templos ✕</span>
          <button class="px-3 py-1 border border-primary/30 text-primary rounded-full text-xs">+ Añadir más</button>
        </div></div>
        <div class="pt-4"><button class="w-full bg-primary text-white py-4 rounded-sm text-base font-bold flex items-center justify-center gap-2 hover:bg-primary-dark transition-all shadow-card">🔄 Regenerar Itinerario</button><p class="text-center text-xs text-text-muted mt-3">⚡ IA optimizada para eficiencia y rutas locales.</p></div>
      </div>
    </section>

    <section class="flex-1 overflow-y-auto p-6 bg-background">
      <div class="max-w-2xl mx-auto">
        <div class="flex justify-between items-end mb-6">
          <div><h3 class="text-xl font-bold text-text-primary font-poppins">Aventura en el Sol Naciente</h3><p class="text-sm text-text-secondary">Tu itinerario personalizado de 7 días en Tokio</p></div>
          <div class="flex gap-2"><button class="p-2 bg-surface shadow-card border border-border dark:border-dark-border rounded-lg">📤</button><button class="p-2 bg-surface shadow-card border border-border dark:border-dark-border rounded-lg">📥</button></div>
        </div>
        <div class="space-y-6 relative before:absolute before:left-[17px] before:top-4 before:bottom-4 before:w-0.5 before:bg-border">
          <div class="relative pl-10">
            <div class="absolute left-0 top-0 w-9 h-9 bg-primary rounded-full flex items-center justify-center text-white shadow-lg z-10"><span class="font-bold text-sm">01</span></div>
            <div class="bg-surface p-5 rounded-lg border border-border dark:border-dark-border shadow-card">
              <div class="flex justify-between mb-4"><h4 class="text-base font-bold text-text-primary">Llegada y Shinjuku Neon</h4><span class="text-xs px-2 py-1 bg-gray-100 rounded text-text-muted">8h estimadas</span></div>
              <div class="grid grid-cols-2 gap-4 mb-4">
                <div class="relative rounded-md overflow-hidden h-28"><img class="object-cover w-full h-full" src="https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?w=400&q=80"/><div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-2"><p class="text-white text-xs font-bold">Shinjuku Gyoen</p></div></div>
                <div class="space-y-3"><div class="flex items-start gap-2"><span class="text-primary text-lg">🍜</span><div><p class="text-sm font-semibold">Almuerzo en Ichiran Ramen</p><p class="text-xs text-text-muted italic">Recomendado por IA</p></div></div><div class="flex items-start gap-2"><span class="text-primary text-lg">👁️</span><div><p class="text-sm font-semibold">Mirador Tokyo Metropolitan</p><p class="text-xs text-text-muted">Entrada gratuita</p></div></div></div>
              </div>
              <div class="flex gap-2"><button class="flex-1 py-2 bg-gray-50 text-primary rounded-xs text-sm hover:bg-primary/10">Ver mapa del día</button><button class="px-4 py-2 border border-border dark:border-dark-border text-text-secondary rounded-xs text-sm hover:bg-gray-50">Editar</button></div>
            </div>
          </div>
          <div class="relative pl-10">
            <div class="absolute left-0 top-0 w-9 h-9 bg-white border-2 border-primary rounded-full flex items-center justify-center text-primary z-10"><span class="font-bold text-sm">02</span></div>
            <div class="bg-white/70 backdrop-blur-md p-5 rounded-lg border border-white shadow-card">
              <div class="flex justify-between mb-4"><h4 class="text-base font-bold text-text-primary">Tradición en Asakusa</h4><span class="text-xs px-2 py-1 bg-accent/20 rounded text-accent font-bold italic">Sugerencia Premium</span></div>
              <p class="text-sm text-text-secondary mb-4">Comienza temprano en el Templo Senso-ji para evitar multitudes. IA sugiere reservar el taller de sushi.</p>
              <div class="flex items-center gap-3 p-3 bg-white/50 rounded-md border border-border dark:border-dark-border"><span class="text-lg">🎫</span><div class="flex-1"><p class="text-sm font-semibold">Tickets: TeamLab Borderless</p><p class="text-xs text-text-muted">Agregado al carrito</p></div><button class="text-primary font-bold text-sm">Reservar</button></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="w-[340px] border-l border-border dark:border-dark-border overflow-y-auto p-6 bg-surface space-y-5">
      <div><div class="flex justify-between items-center mb-2"><label class="text-sm font-semibold text-text-secondary">Ruta del Itinerario</label><button class="text-xs text-primary font-bold">Pantalla completa</button></div><div class="h-48 rounded-lg bg-primary/10 overflow-hidden relative border border-border dark:border-dark-border"><svg class="absolute inset-0 w-full h-full opacity-60" viewBox="0 0 100 100"><path d="M20,80 Q40,40 60,70 T90,20" fill="none" stroke="#0D9488" stroke-dasharray="4" stroke-width="2"/><circle cx="20" cy="80" fill="#0D9488" r="3"/><circle cx="90" cy="20" fill="#0D9488" r="3"/></svg></div></div>
      <div><label class="text-sm font-semibold text-text-secondary mb-2 block">Resumen de Costos</label><div class="bg-gray-50 p-4 rounded-lg border border-border dark:border-dark-border space-y-3">
        <div class="flex justify-between items-center"><div class="flex items-center gap-2"><span class="text-lg">🏨</span><span class="text-sm">Alojamiento (7n)</span></div><span class="text-sm font-semibold">$2.450.000</span></div>
        <div class="flex justify-between items-center"><div class="flex items-center gap-2"><span class="text-lg">🍜</span><span class="text-sm">Alimentación</span></div><span class="text-sm font-semibold">$1.200.000</span></div>
        <div class="flex justify-between items-center"><div class="flex items-center gap-2"><span class="text-lg">🚃</span><span class="text-sm">Transporte Local</span></div><span class="text-sm font-semibold">$450.000</span></div>
        <div class="flex justify-between items-center"><div class="flex items-center gap-2"><span class="text-lg">🎫</span><span class="text-sm">Actividades</span></div><span class="text-sm font-semibold">$850.000</span></div>
        <div class="pt-3 border-t border-border dark:border-dark-border flex justify-between items-end"><div><p class="text-xs text-text-muted uppercase font-bold">Total estimado</p><p class="text-lg font-bold text-primary">$4.950.000 COP</p></div><div class="bg-red-100 text-red-700 text-[10px] px-2 py-1 rounded font-bold">-12% AHORRO</div></div>
      </div></div>
      <div class="bg-accent/20 p-5 rounded-lg border border-accent/30 relative overflow-hidden">
        <div class="absolute -right-4 -bottom-4 opacity-10 text-[100px]">✈️</div>
        <p class="text-lg font-bold text-text-primary mb-1">¡Listo para despegar!</p>
        <p class="text-sm text-text-secondary mb-4">95% de satisfacción en este itinerario.</p>
        <button class="w-full bg-accent text-text-primary py-3 rounded-xs font-bold flex items-center justify-center gap-2 shadow-md">✨ Finalizar y Reservar Todo</button>
      </div>
    </section>
  </div>

</div>
