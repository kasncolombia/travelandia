<%= render partial: "shared/head" %>

<div class="min-h-screen bg-background dark:bg-dark-bg flex flex-col lg:grid lg:grid-rows-[60px_1fr] lg:grid-cols-[260px_1fr] xl:grid-cols-[280px_1fr] lg:h-screen lg:overflow-hidden pb-16 lg:pb-0">

  <%= render partial: "shared/topbar" %>
  <%= render partial: "shared/sidebar" %>

  <!-- PLANNER WORKSPACE -->
  <main class="flex-1 overflow-y-auto lg:overflow-hidden flex flex-col lg:flex-row bg-background dark:bg-dark-bg lg:col-start-2 lg:row-start-2">

    <!-- Config Panel -->
    <section class="w-full lg:w-80 xl:w-96 border-b lg:border-b-0 lg:border-r border-border dark:border-dark-border overflow-y-auto p-4 sm:p-6 bg-surface dark:bg-dark-surface shrink-0">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-10 h-10 rounded-xl bg-accent/20 flex items-center justify-center text-primary shrink-0"><span class="text-xl">🤖</span></div>
        <div>
          <h2 class="text-base sm:text-lg font-bold text-text-primary dark:text-dark-text font-poppins">Configurar Viaje</h2>
          <p class="text-xs text-text-muted dark:text-dark-text-sec">Ajusta preferencias de tu IA</p>
        </div>
      </div>

      <div class="space-y-5">
        <div>
          <label class="text-xs sm:text-sm font-semibold text-text-secondary dark:text-dark-text-sec">Destino principal</label>
          <div class="relative mt-1">
            <span class="absolute left-3 top-2.5 text-primary text-base">📍</span>
            <input class="w-full pl-9 pr-3 py-2 bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border rounded-lg text-xs sm:text-sm outline-none focus:ring-2 focus:ring-primary text-text-primary dark:text-dark-text" type="text" value="Tokio, Japón"/>
          </div>
        </div>

        <div>
          <label class="text-xs sm:text-sm font-semibold text-text-secondary dark:text-dark-text-sec">Fechas del viaje</label>
          <div class="grid grid-cols-2 gap-2 mt-1">
            <div class="bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border p-2.5 rounded-lg">
              <p class="text-[10px] text-text-muted dark:text-dark-text-sec uppercase font-bold">Desde</p>
              <p class="text-xs sm:text-sm font-semibold text-text-primary dark:text-dark-text">15 Oct, 2024</p>
            </div>
            <div class="bg-gray-50 dark:bg-dark-bg border border-border dark:border-dark-border p-2.5 rounded-lg">
              <p class="text-[10px] text-text-muted dark:text-dark-text-sec uppercase font-bold">Hasta</p>
              <p class="text-xs sm:text-sm font-semibold text-text-primary dark:text-dark-text">22 Oct, 2024</p>
            </div>
          </div>
        </div>

        <div>
          <label class="text-xs sm:text-sm font-semibold text-text-secondary dark:text-dark-text-sec">Presupuesto estimado</label>
          <div class="flex items-center gap-3 mt-1">
            <input class="flex-1 accent-primary h-1.5 rounded-full bg-gray-200 dark:bg-dark-border" type="range"/>
            <span class="text-xs sm:text-sm font-bold text-primary">$5.5M</span>
          </div>
        </div>

        <div>
          <label class="text-xs sm:text-sm font-semibold text-text-secondary dark:text-dark-text-sec mb-2 block">Intereses destacados</label>
          <div class="flex flex-wrap gap-1.5">
            <span class="px-2.5 py-1 bg-primary text-white rounded-full text-xs font-medium flex items-center gap-1">Gastronomía ✕</span>
            <span class="px-2.5 py-1 bg-primary text-white rounded-full text-xs font-medium flex items-center gap-1">Fotografía ✕</span>
            <span class="px-2.5 py-1 bg-primary text-white rounded-full text-xs font-medium flex items-center gap-1">Templos ✕</span>
            <button type="button" class="px-2.5 py-1 border border-primary/40 text-primary rounded-full text-xs font-semibold hover:bg-primary-light transition-colors">+ Añadir más</button>
          </div>
        </div>

        <div class="pt-2">
          <button class="w-full bg-primary hover:bg-primary-dark text-white py-3 rounded-lg text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition-all shadow-md">🔄 Regenerar Itinerario</button>
          <p class="text-center text-[11px] text-text-muted dark:text-dark-text-sec mt-2">⚡ IA optimizada para eficiencia y rutas locales.</p>
        </div>
      </div>
    </section>

    <!-- Itinerary Flow -->
    <section class="flex-1 overflow-y-auto p-4 sm:p-6 bg-background dark:bg-dark-bg">
      <div class="max-w-2xl mx-auto space-y-6">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-3 pb-2 border-b border-border dark:border-dark-border">
          <div>
            <h3 class="text-lg sm:text-xl font-bold text-text-primary dark:text-dark-text font-poppins">Aventura en el Sol Naciente</h3>
            <p class="text-xs sm:text-sm text-text-secondary dark:text-dark-text-sec">Tu itinerario personalizado de 7 días en Tokio</p>
          </div>
          <div class="flex gap-2">
            <button class="p-2 bg-surface dark:bg-dark-surface shadow-sm border border-border dark:border-dark-border rounded-lg text-text-primary dark:text-dark-text hover:bg-gray-50" title="Compartir">📤</button>
            <button class="p-2 bg-surface dark:bg-dark-surface shadow-sm border border-border dark:border-dark-border rounded-lg text-text-primary dark:text-dark-text hover:bg-gray-50" title="Descargar PDF">📥</button>
          </div>
        </div>

        <!-- Timeline -->
        <div class="space-y-6 relative before:absolute before:left-[17px] before:top-4 before:bottom-4 before:w-0.5 before:bg-border dark:before:bg-dark-border">
          <!-- Day 01 -->
          <div class="relative pl-10">
            <div class="absolute left-0 top-0 w-9 h-9 bg-primary rounded-full flex items-center justify-center text-white shadow-md z-10"><span class="font-bold text-xs sm:text-sm">01</span></div>
            <div class="bg-surface dark:bg-dark-surface p-4 sm:p-5 rounded-xl border border-border dark:border-dark-border shadow-card">
              <div class="flex justify-between items-start mb-3 gap-2">
                <h4 class="text-sm sm:text-base font-bold text-text-primary dark:text-dark-text">Llegada y Shinjuku Neon</h4>
                <span class="text-[10px] sm:text-xs px-2 py-0.5 bg-gray-100 dark:bg-dark-bg rounded text-text-muted dark:text-dark-text-sec shrink-0">8h estimadas</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                <div class="relative rounded-lg overflow-hidden h-28">
                  <img class="object-cover w-full h-full" src="https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?w=400&q=80" alt="Shinjuku"/>
                  <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent flex items-end p-2">
                    <p class="text-white text-xs font-bold">Shinjuku Gyoen</p>
                  </div>
                </div>
                <div class="space-y-2.5">
                  <div class="flex items-start gap-2">
                    <span class="text-primary text-base">🍜</span>
                    <div>
                      <p class="text-xs sm:text-sm font-semibold text-text-primary dark:text-dark-text">Almuerzo en Ichiran Ramen</p>
                      <p class="text-[11px] text-text-muted dark:text-dark-text-sec italic">Recomendado por IA</p>
                    </div>
                  </div>
                  <div class="flex items-start gap-2">
                    <span class="text-primary text-base">👁️</span>
                    <div>
                      <p class="text-xs sm:text-sm font-semibold text-text-primary dark:text-dark-text">Mirador Tokyo Metropolitan</p>
                      <p class="text-[11px] text-text-muted dark:text-dark-text-sec">Entrada gratuita</p>
                    </div>
                  </div>
                </div>
              </div>
              <div class="flex gap-2">
                <button class="flex-1 py-2 bg-gray-50 dark:bg-dark-bg text-primary rounded-lg text-xs font-semibold hover:bg-primary-light transition-colors">Ver mapa del día</button>
                <button class="px-3.5 py-2 border border-border dark:border-dark-border text-text-secondary dark:text-dark-text-sec rounded-lg text-xs font-semibold hover:bg-gray-50">Editar</button>
              </div>
            </div>
          </div>

          <!-- Day 02 -->
          <div class="relative pl-10">
            <div class="absolute left-0 top-0 w-9 h-9 bg-surface dark:bg-dark-surface border-2 border-primary rounded-full flex items-center justify-center text-primary z-10"><span class="font-bold text-xs sm:text-sm">02</span></div>
            <div class="bg-surface dark:bg-dark-surface p-4 sm:p-5 rounded-xl border border-border dark:border-dark-border shadow-card">
              <div class="flex justify-between items-start mb-3 gap-2">
                <h4 class="text-sm sm:text-base font-bold text-text-primary dark:text-dark-text">Tradición en Asakusa</h4>
                <span class="text-[10px] sm:text-xs px-2 py-0.5 bg-accent/20 text-accent font-bold rounded">Sugerencia Premium</span>
              </div>
              <p class="text-xs sm:text-sm text-text-secondary dark:text-dark-text-sec mb-3">Comienza temprano en el Templo Senso-ji para evitar multitudes. IA sugiere reservar el taller de sushi.</p>
              <div class="flex items-center gap-3 p-3 bg-gray-50 dark:bg-dark-bg rounded-lg border border-border dark:border-dark-border">
                <span class="text-base">🎫</span>
                <div class="flex-1 min-w-0">
                  <p class="text-xs sm:text-sm font-semibold text-text-primary dark:text-dark-text truncate">Tickets: TeamLab Borderless</p>
                  <p class="text-[11px] text-text-muted dark:text-dark-text-sec">Agregado al carrito</p>
                </div>
                <button class="text-primary font-bold text-xs hover:underline shrink-0">Reservar</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Map & Summary Panel -->
    <section class="w-full lg:w-80 xl:w-96 border-t lg:border-t-0 lg:border-l border-border dark:border-dark-border overflow-y-auto p-4 sm:p-6 bg-surface dark:bg-dark-surface space-y-5 shrink-0">
      <div>
        <div class="flex justify-between items-center mb-2">
          <label class="text-xs sm:text-sm font-semibold text-text-secondary dark:text-dark-text-sec">Ruta del Itinerario</label>
          <button class="text-xs text-primary font-bold hover:underline">Pantalla completa</button>
        </div>
        <div class="h-40 sm:h-44 rounded-xl bg-primary/10 overflow-hidden relative border border-border dark:border-dark-border">
          <svg class="absolute inset-0 w-full h-full opacity-60" viewBox="0 0 100 100">
            <path d="M20,80 Q40,40 60,70 T90,20" fill="none" stroke="#0D9488" stroke-dasharray="4" stroke-width="2"/>
            <circle cx="20" cy="80" fill="#0D9488" r="4"/>
            <circle cx="90" cy="20" fill="#0D9488" r="4"/>
          </svg>
        </div>
      </div>

      <div>
        <label class="text-xs sm:text-sm font-semibold text-text-secondary dark:text-dark-text-sec mb-2 block">Resumen de Costos</label>
        <div class="bg-gray-50 dark:bg-dark-bg p-4 rounded-xl border border-border dark:border-dark-border space-y-2.5 text-xs sm:text-sm">
          <div class="flex justify-between items-center"><div class="flex items-center gap-2"><span>🏨</span><span>Alojamiento (7n)</span></div><span class="font-semibold text-text-primary dark:text-dark-text">$2.450.000</span></div>
          <div class="flex justify-between items-center"><div class="flex items-center gap-2"><span>🍜</span><span>Alimentación</span></div><span class="font-semibold text-text-primary dark:text-dark-text">$1.200.000</span></div>
          <div class="flex justify-between items-center"><div class="flex items-center gap-2"><span>🚃</span><span>Transporte Local</span></div><span class="font-semibold text-text-primary dark:text-dark-text">$450.000</span></div>
          <div class="flex justify-between items-center"><div class="flex items-center gap-2"><span>🎫</span><span>Actividades</span></div><span class="font-semibold text-text-primary dark:text-dark-text">$850.000</span></div>
          <div class="pt-2.5 border-t border-border dark:border-dark-border flex justify-between items-end">
            <div>
              <p class="text-[10px] text-text-muted dark:text-dark-text-sec uppercase font-bold">Total estimado</p>
              <p class="text-base sm:text-lg font-bold text-primary">$4.950.000 COP</p>
            </div>
            <span class="bg-red-100 dark:bg-red-900/30 text-red-700 text-[10px] px-2 py-0.5 rounded font-bold">-12% AHORRO</span>
          </div>
        </div>
      </div>

      <div class="bg-accent/20 p-4 sm:p-5 rounded-xl border border-accent/30 relative overflow-hidden">
        <p class="text-base font-bold text-text-primary dark:text-dark-text mb-0.5">¡Listo para despegar!</p>
        <p class="text-xs text-text-secondary dark:text-dark-text-sec mb-3">95% de satisfacción en este itinerario.</p>
        <button class="w-full bg-accent text-text-primary py-2.5 rounded-lg font-bold text-xs sm:text-sm flex items-center justify-center gap-2 shadow-md hover:bg-yellow-400 transition-colors">✨ Finalizar y Reservar Todo</button>
      </div>
    </section>
  </main>

</div>

<!-- Floating Mobile Navigation -->
<%= render partial: "shared/bottom_nav" %>
